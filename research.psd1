@{
  Entries = @(
    @{ Slug='mcculloch-pitts'; Year=1943; Era=0; Title='A mathematical neuron'; Authors='Warren S. McCulloch and Walter Pitts'; Paper='A logical calculus of the ideas immanent in nervous activity'; Kind='Journal article'; Venue='Bulletin of Mathematical Biophysics, 5, 115–133'; Topic='Foundations'; Summary='An early mathematical account of how networks of idealized neurons could carry out logical operations.'; Description='McCulloch and Pitts modeled nervous activity with simplified, all-or-none units and logical relations. The paper connected the organization of a network to the computations it could represent, helping establish a formal language for studying neural computation.'; Caveat='These were idealized units, not a full biological model. The paper did not introduce the learned weights or training procedures used in modern neural networks.'; DateNote='1943 is the publication year of the linked journal article.'; Url='https://doi.org/10.1007/BF02478259'; LinkLabel='Original journal record' }
    @{ Slug='turing'; Year=1950; Era=0; Title='The imitation game'; Authors='Alan M. Turing'; Paper='Computing Machinery and Intelligence'; Kind='Journal article'; Venue='Mind, LIX (236), 433–460'; Topic='Foundations'; Summary='Turing reframed the question of machine intelligence through an operational test based on conversation.'; Description='Instead of relying on a single definition of thinking, Turing proposed an imitation game and examined objections to machine intelligence. His discussion also considered learning machines, making the paper a foundational inquiry into how machine behavior might be evaluated.'; Caveat='The imitation game is a proposed evaluation, not a proof of consciousness or a complete definition of intelligence.'; DateNote='The journal issue is dated 1 October 1950.'; Url='https://academic.oup.com/mind/article/LIX/236/433/986238'; LinkLabel='Original journal record' }
    @{ Slug='logic-theory-machine'; Year=1956; Era=0; Title='The Logic Theory Machine'; Authors='Allen Newell and Herbert A. Simon'; Paper='The Logic Theory Machine'; Kind='Research report'; Venue='RAND report P-868'; Topic='Symbolic AI'; Summary='Heuristic search made symbolic theorem proving a concrete computational task.'; Description='This report describes a program that searched for proofs in symbolic logic. It used heuristics to select promising lines of reasoning rather than exhaustively enumerating every possibility, illustrating an early approach to automated problem solving.'; Caveat='Its achievements concerned a restricted formal problem domain. They did not demonstrate unrestricted reasoning about the everyday world.'; DateNote='The linked RAND report is dated 12 July 1956.'; Url='https://bitsavers.org/pdf/rand/ipl/P-868_The_Logic_Theory_Machine_Jul56.pdf'; LinkLabel='Original report scan (PDF)' }
    @{ Slug='perceptron'; Year=1958; Era=0; Title='Learning with the perceptron'; Authors='Frank Rosenblatt'; Paper='The perceptron: A probabilistic model for information storage and organization in the brain'; Kind='Journal article'; Venue='Psychological Review, 65 (6), 386–408'; Topic='Neural learning'; Summary='A trainable model connected adaptive weights with pattern recognition.'; Description='Rosenblatt described a probabilistic model of perception and learning. The perceptron became an influential example of a system that could adjust its behavior from examples, giving neural learning a concrete mathematical and experimental direction.'; Caveat='The capabilities of a single-layer perceptron are limited. This entry does not treat it as equivalent to a modern multilayer network.'; DateNote='1958 dates this journal paper. Earlier perceptron reports exist, so this is not an invention-date claim.'; Url='https://pubmed.ncbi.nlm.nih.gov/13602029/'; LinkLabel='Indexed publication record'; SecondUrl='https://web.stanford.edu/class/psych209a/ReadingsByDate/01_30/Rosenblatt58Perceptron.pdf'; SecondLabel='Original article scan (PDF)' }
    @{ Slug='lisp'; Year=1960; Era=0; Title='Lisp and symbolic computation'; Authors='John McCarthy'; Paper='Recursive Functions of Symbolic Expressions and Their Computation by Machine, Part I'; Kind='Journal article'; Venue='Communications of the ACM, April 1960'; Topic='Tools & languages'; Summary='Recursive operations on symbolic expressions provided a foundation for Lisp.'; Description='McCarthy presented a formalism for symbolic expressions and their computation, including recursive functions. This gave AI researchers a language suited to manipulating programs and symbolic structures, rather than treating numerical calculation as the only computing task.'; Caveat='Lisp development began before the paper appeared. The timeline dates the publication, not the first implementation.'; DateNote='The linked paper was published in April 1960, rather than 1958.'; Url='https://www-formal.stanford.edu/jmc/recursive/recursive.html'; LinkLabel='Paper in the author archive'; SecondUrl='https://www-formal.stanford.edu/jmc/recursive.pdf'; SecondLabel='Original paper (PDF)' }
    @{ Slug='eliza'; Year=1966; Era=0; Title='ELIZA and conversational patterns'; Authors='Joseph Weizenbaum'; Paper='ELIZA: A computer program for the study of natural language communication between man and machine'; Kind='Journal article'; Venue='Communications of the ACM, 9 (1), 36–45'; Topic='Language'; Summary='Scripted pattern matching produced a convincing surface of conversation.'; Description='ELIZA analyzed input using rules and transformation patterns to generate replies. The paper showed how a limited conversational program could sustain an interaction without requiring a broad representation of the world.'; Caveat='Fluent-looking replies did not establish that ELIZA understood the conversation. Its behavior depended on scripts and pattern transformations.'; DateNote='The linked article appeared in January 1966.'; Url='https://web.stanford.edu/class/cs124/p36-weizenabaum.pdf'; LinkLabel='Original article scan (PDF)' }
    @{ Slug='perceptrons'; Year=1969; Era=1; Title='Mapping the limits of perceptrons'; Authors='Marvin Minsky and Seymour Papert'; Paper='Perceptrons: An Introduction to Computational Geometry'; Kind='Research monograph'; Venue='MIT Press, original edition'; Topic='Theory'; Summary='A mathematical analysis clarified limitations of restricted perceptron architectures.'; Description='Minsky and Papert examined which properties certain perceptron systems could compute. The book is included as a foundational research monograph because its precise questions about representation and computational limits are central to the history of neural networks.'; Caveat='Its results do not disprove the usefulness of all neural networks. Nor does this source establish that one book alone caused an AI funding winter.'; DateNote='1969 is the original edition, not the later expanded edition.'; Url='https://mitpress.mit.edu/9780262130431/perceptrons/'; LinkLabel='Original edition publisher record' }
    @{ Slug='shrdlu'; Year=1971; Era=1; Title='SHRDLU grounds language in a small world'; Authors='Terry Winograd'; Paper='Procedures as a Representation for Data in a Computer Program for Understanding Natural Language'; Kind='Thesis / research report'; Venue='MIT Artificial Intelligence Laboratory, AI-TR-235'; Topic='Symbolic AI'; Summary='Language, reasoning, and action were integrated in a constrained blocks world.'; Description='Winograd described a system that interpreted instructions and questions with reference to objects and actions in a small simulated environment. The work demonstrated how syntax, semantic representations, and domain knowledge could cooperate in a conversational system.'; Caveat='The blocks world was deliberately restricted. Success there did not imply general language understanding in open environments.'; DateNote='This timeline uses the 1971 MIT thesis/report, rather than a development date or the 1972 book.'; Url='https://hdl.handle.net/1721.1/7095'; LinkLabel='MIT thesis and report archive' }
    @{ Slug='mycin'; Year=1973; Era=1; Title='Expert knowledge becomes explicit rules'; Authors='Edward H. Shortliffe and colleagues'; Paper='An artificial intelligence program to advise physicians regarding antimicrobial therapy'; Kind='Journal article'; Venue='Computers and Biomedical Research, 6 (6), 544–560'; Topic='Expert systems'; Summary='Early MYCIN research explored rule-based advice in a tightly defined specialist domain.'; Description='This paper describes an AI program for advising on antimicrobial therapy. It is a representative publication from expert-system research, where specialized knowledge and inference procedures were encoded explicitly to support decisions within a defined domain.'; Caveat='A historical research system is not evidence of suitability for present-day clinical decisions. The entry makes no claim of routine clinical deployment.'; DateNote='The linked article appeared in December 1973; later MYCIN theses and reports have different dates.'; Url='https://pubmed.ncbi.nlm.nih.gov/4589706/'; LinkLabel='Indexed publication record'; SecondUrl='https://doi.org/10.1016/0010-4809(73)90029-3'; SecondLabel='Original publisher record' }
    @{ Slug='hopfield'; Year=1982; Era=1; Title='Memory as a network attractor'; Authors='John J. Hopfield'; Paper='Neural networks and physical systems with emergent collective computational abilities'; Kind='Journal article'; Venue='Proceedings of the National Academy of Sciences, 79 (8), 2554–2558'; Topic='Neural learning'; Summary='Recurrent networks linked associative memory with the dynamics of physical systems.'; Description='Hopfield studied networks whose collective dynamics could recover stored patterns from partial or imperfect input. The relationship between stable states and memory made recurrent neural computation accessible through an energy-based mathematical viewpoint.'; Caveat='Stable states and successful retrieval depend on the model and stored patterns. This is not a model of every form of biological memory.'; DateNote='The journal article appeared in April 1982.'; Url='https://pmc.ncbi.nlm.nih.gov/articles/PMC346238/'; LinkLabel='Full original article in PMC'; SecondUrl='https://pubmed.ncbi.nlm.nih.gov/6953413/'; SecondLabel='Indexed publication record' }
    @{ Slug='backpropagation'; Year=1986; Era=1; Title='Learning internal representations'; Authors='David E. Rumelhart, Geoffrey E. Hinton and Ronald J. Williams'; Paper='Learning representations by back-propagating errors'; Kind='Journal article'; Venue='Nature, 323, 533–536'; Topic='Neural learning'; Summary='Backpropagation demonstrated how hidden units could learn useful internal representations.'; Description='The paper explained how errors at a network output could guide weight changes in earlier layers. Its examples showed that a multilayer network could learn internal features, helping make gradient-based learning a practical research direction.'; Caveat='This influential paper did not invent every form of reverse-mode differentiation or all earlier uses of backpropagation. Credit for the broader history is shared.'; DateNote='The Nature paper was published on 9 October 1986.'; Url='https://www.nature.com/articles/323533a0'; LinkLabel='Original Nature article' }
    @{ Slug='universal-approximation'; Year=1989; Era=1; Title='The expressive power of a hidden layer'; Authors='Kurt Hornik, Maxwell Stinchcombe and Halbert White'; Paper='Multilayer feedforward networks are universal approximators'; Kind='Journal article'; Venue='Neural Networks, 2 (5), 359–366'; Topic='Theory'; Summary='Under stated conditions, feedforward networks can approximate broad classes of functions.'; Description='This theoretical work established approximation capabilities of multilayer feedforward networks. It helped explain why even a network with a single hidden layer, when given enough units and suitable assumptions, could represent a rich set of input-output relationships.'; Caveat='Representational capacity does not guarantee that training finds the right weights, that the required network is small, or that predictions generalize.'; DateNote='1989 dates this particular universal-approximation paper; it is not a claim of sole priority for the theorem family.'; Url='https://www.sciencedirect.com/science/article/pii/0893608089900208'; LinkLabel='Original journal article' }
    @{ Slug='support-vector-networks'; Year=1995; Era=2; Title='Support-vector networks'; Authors='Corinna Cortes and Vladimir Vapnik'; Paper='Support-vector networks'; Kind='Journal article'; Venue='Machine Learning, 20, 273–297'; Topic='Statistical learning'; Summary='Margin-based classification offered a powerful approach to nonlinear learning.'; Description='Cortes and Vapnik developed support-vector networks for classification, combining a margin-based objective with a feature-space view of nonlinear decision boundaries. The paper became a central reference for statistical learning methods.'; Caveat='A large margin is not a universal guarantee of accuracy on new data. Results depend on data, representation, regularization, and evaluation.'; DateNote='The linked journal article was published in September 1995.'; Url='https://link.springer.com/article/10.1007/BF00994018'; LinkLabel='Original journal article' }
    @{ Slug='lstm'; Year=1997; Era=2; Title='Long Short-Term Memory'; Authors='Sepp Hochreiter and Jürgen Schmidhuber'; Paper='Long Short-Term Memory'; Kind='Journal article'; Venue='Neural Computation, 9 (8), 1735–1780'; Topic='Sequence learning'; Summary='Memory cells and gates addressed difficulties in learning long-range dependencies.'; Description='LSTM introduced a recurrent architecture designed to preserve useful error signals over long intervals. Its memory mechanism and gates provided a way to learn which information to retain and when to use it in sequence tasks.'; Caveat='LSTM mitigates particular learning difficulties; it does not guarantee perfect recall or unlimited reasoning over long sequences.'; DateNote='The original journal paper appeared in November 1997.'; Url='https://direct.mit.edu/neco/article/9/8/1735/6109/Long-Short-Term-Memory'; LinkLabel='Original journal article'; SecondUrl='https://people.idsia.ch/~juergen/lstm1997-2024head.pdf'; SecondLabel='Author-hosted paper (PDF)' }
    @{ Slug='document-recognition'; Year=1998; Era=2; Title='Convolutional networks read documents'; Authors='Yann LeCun, Léon Bottou, Yoshua Bengio and Patrick Haffner'; Paper='Gradient-Based Learning Applied to Document Recognition'; Kind='Journal article'; Venue='Proceedings of the IEEE, 86 (11), 2278–2324'; Topic='Computer vision'; Summary='Convolutional networks and gradient-based training connected representation learning with document recognition.'; Description='The paper brought together convolutional architectures, learning methods, and document-recognition systems. It showed how trainable components could be combined into systems for recognizing characters and interpreting documents, including bank-check applications.'; Caveat='The work concerned specific recognition tasks and systems. It did not introduce all convolutional ideas or establish general visual understanding.'; DateNote='The paper appeared in November 1998.'; Url='https://proceedingsoftheieee.ieee.org/gradient-based-learning-applied-to-document-recognition/'; LinkLabel='Original publisher record'; SecondUrl='https://bottou.org/papers/lecun-98h'; SecondLabel='Author publication page' }
    @{ Slug='deep-belief-nets'; Year=2006; Era=2; Title='Training deeper networks layer by layer'; Authors='Geoffrey E. Hinton, Simon Osindero and Yee-Whye Teh'; Paper='A Fast Learning Algorithm for Deep Belief Nets'; Kind='Journal article'; Venue='Neural Computation, 18, 1527–1554'; Topic='Deep learning'; Summary='Greedy layerwise learning provided an effective training strategy for deep belief networks.'; Description='The authors introduced a learning algorithm that trained a deep generative model one layer at a time, followed by a fine-tuning procedure. The work helped renew interest in learning useful hierarchies of representations.'; Caveat='Layerwise pretraining is a particular method for particular models. It is not a necessary step in all modern deep learning.'; DateNote='The linked Neural Computation paper was published in 2006.'; Url='https://www.cs.toronto.edu/~hinton/absps/fastnc.pdf'; LinkLabel='Author-hosted original paper (PDF)' }
    @{ Slug='imagenet'; Year=2009; Era=2; Title='ImageNet expands the data frontier'; Authors='Jia Deng and colleagues'; Paper='ImageNet: A Large-Scale Hierarchical Image Database'; Kind='Conference paper'; Venue='IEEE Conference on Computer Vision and Pattern Recognition'; Topic='Datasets'; Summary='A large, organized image database created new opportunities for visual recognition research.'; Description='ImageNet organized images using a semantic hierarchy and supplied labeled examples at a scale intended to support broad object recognition. The paper established the database as research infrastructure, distinct from the later annual challenge.'; Caveat='A dataset is not a model. Benchmark performance measures performance under a particular dataset and evaluation protocol.'; DateNote='The database paper appeared at CVPR 2009. This is distinct from later ImageNet challenge results.'; Url='https://image-net.org/static_files/papers/imagenet_cvpr09.pdf'; LinkLabel='Original project paper (PDF)'; SecondUrl='https://www.image-net.org/about'; SecondLabel='ImageNet project publication information' }
    @{ Slug='scikit-learn'; Year=2011; Era=2; Title='A shared toolkit for machine learning'; Authors='Fabian Pedregosa and colleagues'; Paper='Scikit-learn: Machine Learning in Python'; Kind='Journal article'; Venue='Journal of Machine Learning Research, 12, 2825–2830'; Topic='Tools & languages'; Summary='A consistent software interface made established learning methods easier to use and compare.'; Description='The scikit-learn paper describes a Python library that brings together supervised and unsupervised learning tools with an emphasis on usability, documentation, and integration with the scientific Python ecosystem.'; Caveat='This milestone concerns research software and access to methods, rather than a new universal learning algorithm.'; DateNote='2011 is the journal paper date. It is not the software project start date.'; Url='https://jmlr.org/papers/v12/pedregosa11a.html'; LinkLabel='Open-access JMLR article' }
    @{ Slug='alexnet'; Year=2012; Era=2; Title='Deep convolutional learning at ImageNet scale'; Authors='Alex Krizhevsky, Ilya Sutskever and Geoffrey E. Hinton'; Paper='ImageNet Classification with Deep Convolutional Neural Networks'; Kind='Conference paper'; Venue='Advances in Neural Information Processing Systems'; Topic='Computer vision'; Summary='GPU-trained convolutional networks substantially improved large-scale image classification.'; Description='The system commonly called AlexNet combined a deep convolutional architecture with effective training techniques and GPU computation. Its ImageNet results provided compelling evidence that learned visual representations could improve performance at scale.'; Caveat='The result was a classification benchmark breakthrough, not proof that the system understood images in the full human sense.'; DateNote='The paper appeared at the 2012 neural information processing conference.'; Url='https://papers.nips.cc/paper_files/paper/2012/hash/c399862d3b9d6b76c8436e924a68c45b-Abstract.html'; LinkLabel='Original conference proceedings' }
    @{ Slug='word2vec'; Year=2013; Era=3; Title='Efficient word representations'; Authors='Tomas Mikolov and colleagues'; Paper='Efficient Estimation of Word Representations in Vector Space'; Kind='Preprint'; Venue='arXiv:1301.3781'; Topic='Language'; Summary='Efficient training made useful continuous word vectors available at large scale.'; Description='The paper proposed architectures for learning vector representations of words from large text collections. Relationships in the learned space could capture useful syntactic and semantic regularities, supporting downstream language tasks.'; Caveat='Vector relationships are statistical regularities. They do not guarantee factual knowledge or resolve every meaning a word can have in context.'; DateNote='The first arXiv submission was 16 January 2013.'; Url='https://arxiv.org/abs/1301.3781'; LinkLabel='Paper and version history' }
    @{ Slug='gans'; Year=2014; Era=3; Title='Generative adversarial learning'; Authors='Ian Goodfellow and colleagues'; Paper='Generative Adversarial Networks'; Kind='Preprint / conference paper'; Venue='arXiv:1406.2661; NIPS 2014'; Topic='Generative models'; Summary='A generator and discriminator learned through an adversarial training objective.'; Description='GANs set two models against one another: a generator produces samples, while a discriminator learns to distinguish generated samples from data. This introduced an influential framework for learning generative models.'; Caveat='The theoretical objective does not make practical training automatically stable. The paper is not the origin of every form of generative modeling.'; DateNote='The preprint was submitted on 10 June 2014. The conference paper uses the title Generative Adversarial Nets.'; Url='https://arxiv.org/abs/1406.2661'; LinkLabel='Paper and version history' }
    @{ Slug='dropout'; Year=2014; Era=3; Title='Dropout regularizes neural networks'; Authors='Nitish Srivastava and colleagues'; Paper='Dropout: A Simple Way to Prevent Neural Networks from Overfitting'; Kind='Journal article'; Venue='Journal of Machine Learning Research, 15, 1929–1958'; Topic='Training methods'; Summary='Randomly omitting units during training helped reduce overfitting.'; Description='Dropout trains with randomly thinned networks so units cannot rely as strongly on specific partners. The paper explains the method and evaluates its ability to improve generalization across several neural-network tasks.'; Caveat='Dropout is a regularization method whose usefulness depends on the architecture and training setup. It is not a guarantee against overfitting.'; DateNote='2014 dates this JMLR article. Earlier dropout work was reported in 2012.'; Url='https://jmlr.org/papers/v15/srivastava14a.html'; LinkLabel='Open-access JMLR article' }
    @{ Slug='deep-q-learning'; Year=2015; Era=3; Title='Deep reinforcement learning from pixels'; Authors='Volodymyr Mnih and colleagues'; Paper='Human-level control through deep reinforcement learning'; Kind='Journal article'; Venue='Nature, 518, 529–533'; Topic='Reinforcement learning'; Summary='A deep Q-network learned control policies from game images and rewards.'; Description='The work combined reinforcement learning with deep representation learning to tackle Atari games using screen pixels as input. It demonstrated that a shared learning approach could perform strongly across a range of games.'; Caveat='The title does not mean the system exceeded humans at every game. The evaluation concerned the games and protocols described in the paper.'; DateNote='The Nature article appeared on 25 February 2015. Earlier deep Q-learning research was released in 2013.'; Url='https://www.nature.com/articles/nature14236'; LinkLabel='Original Nature article' }
    @{ Slug='resnet'; Year=2015; Era=3; Title='Residual connections make depth easier to train'; Authors='Kaiming He, Xiangyu Zhang, Shaoqing Ren and Jian Sun'; Paper='Deep Residual Learning for Image Recognition'; Kind='Preprint / conference paper'; Venue='arXiv:1512.03385; CVPR 2016'; Topic='Computer vision'; Summary='Residual learning enabled effective optimization of much deeper image-recognition networks.'; Description='ResNet reformulated layers to learn residual functions relative to their inputs, using shortcut connections. The experiments showed how this formulation could ease optimization and improve recognition with substantially deeper networks.'; Caveat='Residual connections address optimization difficulties; attributing the entire result to a single vanishing-gradient explanation oversimplifies the paper.'; DateNote='The preprint was submitted on 10 December 2015; the conference publication followed in 2016.'; Url='https://arxiv.org/abs/1512.03385'; LinkLabel='Paper and version history' }
    @{ Slug='alphago'; Year=2016; Era=3; Title='Neural networks meet tree search in Go'; Authors='David Silver and colleagues'; Paper='Mastering the game of Go with deep neural networks and tree search'; Kind='Journal article'; Venue='Nature, 529, 484–489'; Topic='Reinforcement learning'; Summary='Policy and value networks strengthened search in a difficult board game.'; Description='AlphaGo combined neural networks for selecting moves and evaluating positions with a tree-search procedure. The system integrated supervised learning from expert play and reinforcement learning to reach a major milestone in computer Go.'; Caveat='This paper reports the match against Fan Hui. It does not report the later March 2016 Lee Sedol match, and it concerns a specific game.'; DateNote='The paper appeared on 27 January 2016 and reports the October 2015 Fan Hui match.'; Url='https://www.nature.com/articles/nature16961'; LinkLabel='Original Nature article' }
    @{ Slug='tensorflow'; Year=2016; Era=3; Title='TensorFlow scales the learning system'; Authors='Martín Abadi and colleagues'; Paper='TensorFlow: A system for large-scale machine learning'; Kind='Preprint / conference paper'; Venue='arXiv:1605.08695; OSDI 2016'; Topic='Tools & languages'; Summary='A dataflow system supported machine-learning workloads across different computing devices.'; Description='The TensorFlow systems paper describes a framework for expressing and executing machine-learning computations across heterogeneous hardware. It addresses the engineering needed to connect experimentation with larger-scale training and deployment.'; Caveat='A software framework enables many models; it is not itself an intelligence algorithm or evidence that any application built with it is reliable.'; DateNote='The paper was first submitted on 27 May 2016. The software was released earlier, in 2015.'; Url='https://arxiv.org/abs/1605.08695'; LinkLabel='Paper and version history' }
    @{ Slug='transformer'; Year=2017; Era=4; Title='Attention Is All You Need'; Authors='Ashish Vaswani and colleagues'; Paper='Attention Is All You Need'; Kind='Preprint / conference paper'; Venue='arXiv:1706.03762; NIPS 2017'; Topic='Architecture'; Summary='The Transformer replaced recurrence with attention in a sequence-to-sequence architecture.'; Description='The paper introduced an encoder-decoder architecture built around attention mechanisms, with positional information to represent sequence order. Translation experiments demonstrated strong results while allowing greater parallelization during training than recurrent approaches.'; Caveat='The original study focused on sequence transduction. The title does not establish that attention alone is sufficient for every kind of intelligence.'; DateNote='The first arXiv submission was 12 June 2017, not 2022.'; Url='https://arxiv.org/abs/1706.03762'; LinkLabel='Paper and version history' }
    @{ Slug='bert'; Year=2018; Era=4; Title='BERT learns bidirectional language representations'; Authors='Jacob Devlin, Ming-Wei Chang, Kenton Lee and Kristina Toutanova'; Paper='BERT: Pre-training of Deep Bidirectional Transformers for Language Understanding'; Kind='Preprint / conference paper'; Venue='arXiv:1810.04805; NAACL 2019'; Topic='Language'; Summary='Masked pretraining helped a bidirectional Transformer transfer to many language tasks.'; Description='BERT learned representations using context on both sides of masked tokens, then adapted those representations to downstream tasks through fine-tuning. The approach reduced the need for elaborate task-specific architectures in the evaluated settings.'; Caveat='BERT is an encoder model with a different training setup from an autoregressive text generator. Benchmark gains do not establish unrestricted understanding.'; DateNote='The preprint appeared on 11 October 2018; the conference paper followed in 2019.'; Url='https://arxiv.org/abs/1810.04805'; LinkLabel='Paper and version history' }
    @{ Slug='gpt-2'; Year=2019; Era=4; Title='GPT-2 explores zero-shot task transfer'; Authors='Alec Radford and colleagues'; Paper='Language Models are Unsupervised Multitask Learners'; Kind='Technical report'; Venue='OpenAI'; Topic='Language'; Summary='A language model performed several tasks without task-specific parameter updates.'; Description='The GPT-2 report evaluated whether next-token prediction over a large web-text dataset could support a variety of language tasks. Task performance emerged from conditioning the model on text, without retraining it separately for each evaluated task.'; Caveat='Performance varied substantially by task. The report did not demonstrate a generally reliable problem solver, and model weights were released in stages.'; DateNote='The report accompanied the 14 February 2019 announcement. The largest model was released later that year.'; Url='https://cdn.openai.com/better-language-models/language_models_are_unsupervised_multitask_learners.pdf'; LinkLabel='Original technical report (PDF)'; SecondUrl='https://openai.com/index/better-language-models/'; SecondLabel='Dated author announcement' }
    @{ Slug='pytorch'; Year=2019; Era=4; Title='PyTorch bridges flexibility and performance'; Authors='Adam Paszke and colleagues'; Paper='PyTorch: An Imperative Style, High-Performance Deep Learning Library'; Kind='Preprint / conference paper'; Venue='arXiv:1912.01703; NeurIPS 2019'; Topic='Tools & languages'; Summary='An imperative programming style supported flexible research with efficient tensor computation.'; Description='The paper describes PyTorch as a deep-learning library combining a familiar imperative programming model with automatic differentiation and accelerated computation. It explains system choices intended to support both experimentation and performance.'; Caveat='This is a systems contribution. The publication year does not mark the first public availability of the library.'; DateNote='The paper appeared at NeurIPS 2019; its arXiv submission is dated 3 December 2019.'; Url='https://arxiv.org/abs/1912.01703'; LinkLabel='Paper and version history' }
    @{ Slug='scaling-laws'; Year=2020; Era=5; Title='Language-model scaling becomes measurable'; Authors='Jared Kaplan and colleagues'; Paper='Scaling Laws for Neural Language Models'; Kind='Preprint'; Venue='arXiv:2001.08361'; Topic='Scaling'; Summary='Empirical relationships connected language-model loss with parameters, data, and compute.'; Description='The authors measured how language-model performance varied with model size, dataset size, and training compute. Approximate scaling relationships offered a way to reason about resource allocation within the studied training regimes.'; Caveat='These are empirical relationships over investigated ranges. They do not prove indefinite improvement, factual reliability, or inevitable general intelligence.'; DateNote='The first arXiv submission was 23 January 2020.'; Url='https://arxiv.org/abs/2001.08361'; LinkLabel='Paper and version history' }
    @{ Slug='gpt-3'; Year=2020; Era=5; Title='GPT-3 learns tasks from examples in context'; Authors='Tom B. Brown and colleagues'; Paper='Language Models are Few-Shot Learners'; Kind='Preprint / conference paper'; Venue='arXiv:2005.14165; NeurIPS 2020'; Topic='Language'; Summary='A large language model performed many tasks using demonstrations supplied in its prompt.'; Description='The paper evaluated GPT-3 in zero-shot, one-shot, and few-shot settings. In the few-shot setup, task examples were placed in the input context, and the model generated answers without task-specific gradient updates.'; Caveat='Learning in context is distinct from updating model weights. The paper also documents weaknesses, and its results do not guarantee truthfulness.'; DateNote='The preprint was submitted on 28 May 2020, not 2022.'; Url='https://arxiv.org/abs/2005.14165'; LinkLabel='Paper and version history' }
    @{ Slug='ddpm'; Year=2020; Era=5; Title='Denoising diffusion produces high-quality images'; Authors='Jonathan Ho, Ajay Jain and Pieter Abbeel'; Paper='Denoising Diffusion Probabilistic Models'; Kind='Preprint / conference paper'; Venue='arXiv:2006.11239; NeurIPS 2020'; Topic='Generative models'; Summary='Learning to reverse gradual noising became an effective image-generation method.'; Description='The paper developed a training formulation for diffusion probabilistic models and demonstrated strong image-generation results. Generation follows a learned denoising process that transforms noise into samples.'; Caveat='Diffusion modeling has earlier research predecessors. This paper is a major formulation and demonstration, not the invention of all diffusion-based generative models.'; DateNote='The preprint was submitted on 19 June 2020. Both the preprint and conference paper are from 2020, not 2021.'; Url='https://arxiv.org/abs/2006.11239'; LinkLabel='Paper and version history' }
    @{ Slug='clip'; Year=2021; Era=5; Title='CLIP connects images with natural language'; Authors='Alec Radford and colleagues'; Paper='Learning Transferable Visual Models From Natural Language Supervision'; Kind='Preprint / conference paper'; Venue='arXiv:2103.00020; ICML 2021'; Topic='Multimodal models'; Summary='Contrastive learning from image-text pairs enabled transfer through natural-language descriptions.'; Description='CLIP learned to associate images with their accompanying text. By comparing an image with text descriptions of candidate classes, the model could perform zero-shot classification without fitting a separate classifier to each evaluated dataset.'; Caveat='Transfer performance depends on the task and prompts. Associations learned from web data are not equivalent to grounded or unbiased understanding.'; DateNote='The arXiv record lists a first submission of 26 February 2021, despite its 2103 identifier.'; Url='https://arxiv.org/abs/2103.00020'; LinkLabel='Paper and version history' }
    @{ Slug='latent-diffusion'; Year=2021; Era=5; Title='Diffusion moves into a compressed latent space'; Authors='Robin Rombach and colleagues'; Paper='High-Resolution Image Synthesis with Latent Diffusion Models'; Kind='Preprint / conference paper'; Venue='arXiv:2112.10752; CVPR 2022'; Topic='Generative models'; Summary='Performing denoising in a learned latent space reduced the computational burden of image synthesis.'; Description='Latent diffusion models combine an image compression model with a diffusion process operating on its latent representation. The work also introduces flexible conditioning, enabling tasks such as text-guided image generation.'; Caveat='This publication is distinct from the subsequent release of Stable Diffusion. A paper date and a product or model-release date need not match.'; DateNote='The first preprint appeared on 20 December 2021; the conference paper was published in 2022.'; Url='https://arxiv.org/abs/2112.10752'; LinkLabel='Paper and version history' }
    @{ Slug='chain-of-thought'; Year=2022; Era=6; Title='Worked reasoning examples guide prompting'; Authors='Jason Wei and colleagues'; Paper='Chain-of-Thought Prompting Elicits Reasoning in Large Language Models'; Kind='Preprint / conference paper'; Venue='arXiv:2201.11903; NeurIPS 2022'; Topic='Reasoning methods'; Summary='Prompts containing intermediate reasoning examples improved performance on several reasoning benchmarks.'; Description='The paper studied demonstrations that include a sequence of intermediate steps before an answer. With sufficiently large language models, these worked examples improved results on tasks such as arithmetic and symbolic reasoning.'; Caveat='A generated chain of thought is not guaranteed to be correct or a faithful account of the model computation. This paper is distinct from zero-shot step-by-step prompting.'; DateNote='The preprint was first submitted in January 2022.'; Url='https://arxiv.org/abs/2201.11903'; LinkLabel='Paper and version history' }
    @{ Slug='instructgpt'; Year=2022; Era=6; Title='Human feedback shapes instruction following'; Authors='Long Ouyang and colleagues'; Paper='Training language models to follow instructions with human feedback'; Kind='Preprint / conference paper'; Venue='arXiv:2203.02155; NeurIPS 2022'; Topic='Alignment'; Summary='Supervised examples and human preference feedback improved how language models followed instructions.'; Description='InstructGPT combined supervised fine-tuning with a reward model trained from human rankings and reinforcement learning. Evaluators preferred outputs from the resulting models over those from the larger baseline in the studied comparisons.'; Caveat='Preference improvements do not eliminate hallucinations, bias, or unsafe behavior. Results depend in part on the instructions and people providing feedback.'; DateNote='The first arXiv submission was 4 March 2022.'; Url='https://arxiv.org/abs/2203.02155'; LinkLabel='Paper and version history' }
    @{ Slug='zero-shot-reasoning'; Year=2022; Era=6; Title='Zero-shot step-by-step prompting'; Authors='Takeshi Kojima and colleagues'; Paper='Large Language Models are Zero-Shot Reasoners'; Kind='Preprint / conference paper'; Venue='arXiv:2205.11916; NeurIPS 2022'; Topic='Reasoning methods'; Summary='A simple step-by-step instruction improved reasoning results without worked examples in the prompt.'; Description='The paper investigated prompting language models to reason through a problem before extracting an answer. The phrase “Let''s think step by step” improved performance on several benchmark tasks without supplying task-specific reasoning demonstrations.'; Caveat='The effect is empirical and task-dependent. It neither guarantees valid reasoning nor makes every model a reliable zero-shot reasoner.'; DateNote='The preprint was submitted on 24 May 2022. This is the source for the familiar zero-shot phrase, distinct from Wei and colleagues'' worked-example method.'; Url='https://arxiv.org/abs/2205.11916'; LinkLabel='Paper and version history' }
    @{ Slug='constitutional-ai'; Year=2022; Era=6; Title='Principles guide AI feedback'; Authors='Yuntao Bai and colleagues'; Paper='Constitutional AI: Harmlessness from AI Feedback'; Kind='Preprint'; Venue='arXiv:2212.08073'; Topic='Alignment'; Summary='Written principles guided self-critique and AI-generated feedback during training.'; Description='Constitutional AI used a set of principles to guide revisions of model responses and to help generate preference feedback. The paper explored reducing dependence on human labels for judgments of harmfulness while improving the behavior of an assistant.'; Caveat='Human choices remain in the principles and other parts of the training process. The method does not establish that the model is harmless in every situation.'; DateNote='The first arXiv submission was 15 December 2022.'; Url='https://arxiv.org/abs/2212.08073'; LinkLabel='Paper and version history' }
    @{ Slug='llama'; Year=2023; Era=7; Title='LLaMA examines efficient foundation models'; Authors='Hugo Touvron and colleagues'; Paper='LLaMA: Open and Efficient Foundation Language Models'; Kind='Preprint'; Venue='arXiv:2302.13971'; Topic='Language'; Summary='A family of language models emphasized training efficiency and publicly available training data.'; Description='The original LLaMA paper introduced models spanning 7 to 65 billion parameters and examined how training choices affected performance. It showed that smaller models trained extensively could be competitive on the reported benchmarks.'; Caveat='The original release had restricted research access. The word “open” in the title does not establish an unrestricted open-source license or full reproducibility.'; DateNote='The first arXiv submission was 27 February 2023.'; Url='https://arxiv.org/abs/2302.13971'; LinkLabel='Paper and version history' }
    @{ Slug='gpt-4'; Year=2023; Era=7; Title='GPT-4 reports broader multimodal capability'; Authors='OpenAI'; Paper='GPT-4 Technical Report'; Kind='Technical report'; Venue='arXiv:2303.08774'; Topic='Multimodal models'; Summary='A large model accepted image and text inputs and generated text outputs.'; Description='The report describes GPT-4 evaluation across a range of professional, academic, and language benchmarks, alongside limitations and safety work. It documents a multimodal model while withholding many details of its architecture and training.'; Caveat='Limited technical disclosure constrains independent reproduction. Strong benchmark results do not establish general intelligence or consistent factual accuracy.'; DateNote='The technical report was first submitted on 15 March 2023. GPT-4o is a separate, later model.'; Url='https://arxiv.org/abs/2303.08774'; LinkLabel='Report and version history' }
    @{ Slug='mistral-7b'; Year=2023; Era=7; Title='Mistral 7B focuses on efficient attention'; Authors='Albert Q. Jiang and colleagues'; Paper='Mistral 7B'; Kind='Technical report'; Venue='arXiv:2310.06825'; Topic='Efficient models'; Summary='Grouped-query and sliding-window attention supported an efficient language-model architecture.'; Description='The report presents Mistral 7B and evaluates it against other models on a range of tasks. Its architecture uses grouped-query attention and sliding-window attention to improve inference efficiency and manage attention computation.'; Caveat='Benchmark comparisons describe the models and evaluation setups in the report. They should not be read as a permanent ranking of available systems.'; DateNote='The paper was submitted on 10 October 2023; the model announcement was on 27 September 2023.'; Url='https://arxiv.org/abs/2310.06825'; LinkLabel='Report and version history'; SecondUrl='https://mistral.ai/news/announcing-mistral-7b/'; SecondLabel='Dated model announcement' }
    @{ Slug='mixtral'; Year=2024; Era=7; Title='Mixtral activates a sparse set of experts'; Authors='Albert Q. Jiang and colleagues'; Paper='Mixtral of Experts'; Kind='Technical report'; Venue='arXiv:2401.04088'; Topic='Efficient models'; Summary='Sparse routing selected two of eight feedforward experts per token at each layer.'; Description='Mixtral uses a sparse mixture-of-experts architecture: a routing mechanism chooses which expert networks process each token. This separates total model capacity from the amount of expert computation used for an individual token.'; Caveat='Only part of the model is active per token, but storing the model still requires its full weights. Sparse activation is not the same as a small total model.'; DateNote='The paper was submitted on 8 January 2024. The model was released in December 2023, so both years can be correct when clearly labeled.'; Url='https://arxiv.org/abs/2401.04088'; LinkLabel='Report and version history'; SecondUrl='https://mistral.ai/news/mixtral-of-experts/'; SecondLabel='December 2023 model announcement' }
    @{ Slug='gemini-1-5'; Year=2024; Era=7; Title='Gemini 1.5 studies long multimodal context'; Authors='Gemini Team'; Paper='Gemini 1.5: Unlocking multimodal understanding across millions of tokens of context'; Kind='Technical report'; Venue='arXiv:2403.05530'; Topic='Multimodal models'; Summary='Long-context experiments included text, video, and audio within a multimodal model family.'; Description='The report evaluates models designed to process very long inputs and retrieve or reason over information within them. Its experiments explore how extended context can support work with long documents and other media.'; Caveat='Context capacity and retrieval results do not guarantee perfect comprehension of every long input. Claims remain tied to the report and its evaluation conditions.'; DateNote='The first arXiv submission was 8 March 2024. The record also contains later revisions.'; Url='https://arxiv.org/abs/2403.05530'; LinkLabel='Report and version history' }
    @{ Slug='deepseek-r1'; Year=2025; Era=7; Title='DeepSeek-R1 explores reinforcement learning for reasoning'; Authors='DeepSeek-AI'; Paper='DeepSeek-R1: Incentivizing Reasoning Capability in LLMs via Reinforcement Learning'; Kind='Technical report / preprint'; Venue='arXiv:2501.12948, version 1'; Topic='Reasoning methods'; Summary='Reinforcement learning improved reasoning benchmarks, with distinct training paths for R1-Zero and R1.'; Description='The report studies reasoning behavior developed through reinforcement learning. R1-Zero applies reinforcement learning to a pretrained base model without preliminary supervised fine-tuning. R1 adds cold-start data and multiple training stages to improve the resulting system.'; Caveat='R1-Zero and R1 must not be conflated. “No preliminary supervised fine-tuning” does not mean the base model was untrained, and benchmark success does not guarantee correct reasoning.'; DateNote='The original report was submitted on 22 January 2025, not 2024. This entry links version 1 to anchor the original report.'; Url='https://arxiv.org/abs/2501.12948v1'; LinkLabel='Original report and submission history' }
