    @{ Slug='mcculloch-pitts'; Tags=@('Neural networks','Computation theory','Logic'); Year=1943; Era=0; Title='A mathematical neuron'; Authors='Warren S. McCulloch and Walter Pitts'; Paper='A logical calculus of the ideas immanent in nervous activity'; Kind='Journal article'; Venue='Bulletin of Mathematical Biophysics, 5, 115–133'; Topic='Foundations'; Summary='An early mathematical account of how networks of idealized neurons could carry out logical operations.'; Description='McCulloch and Pitts modeled nervous activity with simplified, all-or-none units and logical relations. The paper connected the organization of a network to the computations it could represent, helping establish a formal language for studying neural computation.'; Caveat='These were idealized units, not a full biological model. The paper did not introduce the learned weights or training procedures used in modern neural networks.'; DateNote='1943 is the publication year of the linked journal article.'; Url='https://doi.org/10.1007/BF02478259'; LinkLabel='Original journal record' }
    @{ Slug='hebb'; Tags=@('Memory','Neural networks','Associative memory','Learning theory'); Year=1949; Era=0; Title='Learning leaves a lasting neural trace'; Authors='Donald O. Hebb'; Paper='The Organization of Behavior: A Neuropsychological Theory'; Kind='Research monograph'; Venue='Wiley, original edition'; Topic='Memory & learning'; Summary='Cell assemblies and activity-dependent changes connected learning with the organization of neural circuits.'; Description='Hebb proposed that repeated coordinated activity could strengthen connections between neurons, allowing groups of cells to act together as assemblies. The theory connected lasting changes in connections with perception, learning, and memory. It supplied a biological hypothesis that later neural models could formalize as rules for storing associations.'; Caveat='This is a theory of neural organization, not a tested general-purpose AI architecture. The familiar slogan about neurons firing together compresses a more specific proposal.'; DateNote='1949 dates the original Wiley edition. Later reprints and digital copies retain the original work but have different publication dates.'; Url='https://books.google.com/books/about/The_Organization_of_Behavior.html?id=dZ0eDiLTwuEC'; LinkLabel='Original-edition book record'; SecondUrl='https://www.mpi.nl/publications/item2346268/organization-behavior-neuropsychological-theory'; SecondLabel='Research-library record and full-text links'; CitedBy=@(@{Entry='perceptron';Note='Reference 7 cites the 1949 book.';SourceUrl='https://web.stanford.edu/class/psych209a/ReadingsByDate/01_30/Rosenblatt58Perceptron.pdf'},@{Entry='hopfield';Note='Reference 27 cites the 1949 book.';SourceUrl='https://authors.library.caltech.edu/records/w41x7-8bn13/files/HOPpnas82.pdf?download=1'}) }
    @{ Slug='turing'; Tags=@('Evaluation','Natural language processing','Learning theory'); Year=1950; Era=0; Title='The imitation game'; Authors='Alan M. Turing'; Paper='Computing Machinery and Intelligence'; Kind='Journal article'; Venue='Mind, LIX (236), 433–460'; Topic='Foundations'; Summary='Turing reframed the question of machine intelligence through an operational test based on conversation.'; Description='Instead of relying on a single definition of thinking, Turing proposed an imitation game and examined objections to machine intelligence. His discussion also considered learning machines, making the paper a foundational inquiry into how machine behavior might be evaluated.'; Caveat='The imitation game is a proposed evaluation, not a proof of consciousness or a complete definition of intelligence.'; DateNote='The journal issue is dated 1 October 1950.'; Url='https://academic.oup.com/mind/article/LIX/236/433/986238'; LinkLabel='Original journal record' }
    @{ Slug='logic-theory-machine'; Tags=@('Symbolic AI','Reasoning','Search','Logic'); Year=1956; Era=0; Title='The Logic Theory Machine'; Authors='Allen Newell and Herbert A. Simon'; Paper='The Logic Theory Machine'; Kind='Research report'; Venue='RAND report P-868'; Topic='Symbolic AI'; Summary='Heuristic search made symbolic theorem proving a concrete computational task.'; Description='This report describes a program that searched for proofs in symbolic logic. It used heuristics to select promising lines of reasoning rather than exhaustively enumerating every possibility, illustrating an early approach to automated problem solving.'; Caveat='Its achievements concerned a restricted formal problem domain. They did not demonstrate unrestricted reasoning about the everyday world.'; DateNote='The linked RAND report is dated 12 July 1956.'; Url='https://bitsavers.org/pdf/rand/ipl/P-868_The_Logic_Theory_Machine_Jul56.pdf'; LinkLabel='Original report scan (PDF)' }
    @{ Slug='perceptron'; Tags=@('Neural networks','Machine learning','Pattern recognition'); Year=1958; Era=0; Title='Learning with the perceptron'; Authors='Frank Rosenblatt'; Paper='The perceptron: A probabilistic model for information storage and organization in the brain'; Kind='Journal article'; Venue='Psychological Review, 65 (6), 386–408'; Topic='Neural learning'; Summary='A trainable model connected adaptive weights with pattern recognition.'; Description='Rosenblatt described a probabilistic model of perception and learning. The perceptron became an influential example of a system that could adjust its behavior from examples, giving neural learning a concrete mathematical and experimental direction.'; Caveat='The capabilities of a single-layer perceptron are limited. This entry does not treat it as equivalent to a modern multilayer network.'; DateNote='1958 dates this journal paper. Earlier perceptron reports exist, so this is not an invention-date claim.'; Url='https://pubmed.ncbi.nlm.nih.gov/13602029/'; LinkLabel='Indexed publication record'; SecondUrl='https://web.stanford.edu/class/psych209a/ReadingsByDate/01_30/Rosenblatt58Perceptron.pdf'; SecondLabel='Original article scan (PDF)' }
    @{ Slug='lisp'; Tags=@('Symbolic AI','Tools & frameworks','Knowledge representation'); Year=1960; Era=0; Title='Lisp and symbolic computation'; Authors='John McCarthy'; Paper='Recursive Functions of Symbolic Expressions and Their Computation by Machine, Part I'; Kind='Journal article'; Venue='Communications of the ACM, April 1960'; Topic='Tools & languages'; Summary='Recursive operations on symbolic expressions provided a foundation for Lisp.'; Description='McCarthy presented a formalism for symbolic expressions and their computation, including recursive functions. This gave AI researchers a language suited to manipulating programs and symbolic structures, rather than treating numerical calculation as the only computing task.'; Caveat='Lisp development began before the paper appeared. The timeline dates the publication, not the first implementation.'; DateNote='The linked paper was published in April 1960, rather than 1958.'; Url='https://www-formal.stanford.edu/jmc/recursive/recursive.html'; LinkLabel='Paper in the author archive'; SecondUrl='https://www-formal.stanford.edu/jmc/recursive.pdf'; SecondLabel='Original paper (PDF)' }
    @{ Slug='sir'; Tags=@('Memory','Recall','Symbolic AI','Knowledge representation','Natural language processing'); Year=1964; Era=0; Title='SIR stores facts and reasons over them'; Authors='Bertram Raphael'; Paper='SIR: A Computer Program for Semantic Information Retrieval'; Kind='Thesis / research report'; Venue='MIT Artificial Intelligence Laboratory, AI-TR-220'; Topic='Semantic memory'; Summary='A small language system built an internal model from statements and searched it to answer later questions.'; Description='SIR accepted restricted English statements and questions. It stored relational information using associations and property lists, then searched that model to answer queries and draw deductions. The separation between receiving a fact and later retrieving its consequences makes it an early example of memory supporting an ongoing interaction.'; Caveat='Its language and reasoning were constrained by the supplied formats and domain. Storing conversational facts did not establish broad language understanding or unlimited learning.'; DateNote='The linked MIT archive dates AI-TR-220 to June 1964. SHRDLU cites this work using a 1964 label but points to its later chapter in Semantic Information Processing; the entry anchors the original report.'; Url='https://dspace.mit.edu/entities/publication/441f4bda-eb58-4e51-b070-06d67cf76ca9'; LinkLabel='Original report in the MIT archive'; SecondUrl='https://www.bitsavers.org/pdf/mit/ai/aim/AITR-220.pdf'; SecondLabel='Original report scan (PDF)'; CitedBy=@(@{Entry='shrdlu';Note='Reference 46, printed page 461. The reference points to the later chapter version under a 1964 citation label.';SourceUrl='https://dspace.mit.edu/server/api/core/bitstreams/bd092d44-1552-4417-a19e-a4704c94d3ff/content'}) }
    @{ Slug='student'; Year=1964; Era=0; Title='STUDENT turns word problems into equations'; Authors='Daniel G. Bobrow'; Paper='Natural Language Input for a Computer Problem Solving System'; Kind='Thesis / research report'; Venue='MIT, AI-TR-219'; Topic='Mathematical reasoning'; Summary='A restricted English interface translated algebra story problems into equations and solved for unknowns.'; Description='STUDENT transformed supported sentences into simultaneous equations. It could use stored general information, disclose assumptions, and ask for additional information when a problem could not be solved. This connected language interpretation with an explicit mathematical representation and a separate solution procedure.'; Caveat='The input language and problem types were restricted. The system did not demonstrate general mathematical reasoning from arbitrary prose.'; DateNote='1964 dates the original report. SHRDLU reference 3 uses a 1964 label while citing the later chapter in the 1968 collection Semantic Information Processing.'; Url='https://dspace.mit.edu/handle/1721.1/6903'; LinkLabel='Original MIT report record'; SecondUrl='https://bitsavers.trailing-edge.com/pdf/mit/ai/aim/AITR-219.pdf'; SecondLabel='Original thesis scan (PDF)'; Tags=@('Reasoning','Mathematical reasoning','Natural language processing','Symbolic AI'); CitedBy=@(@{Entry='shrdlu';Note='Reference 3 cites the chapter version under a 1964 label; this entry dates the original report.';SourceUrl='https://dspace.mit.edu/server/api/core/bitstreams/bd092d44-1552-4417-a19e-a4704c94d3ff/content'}) }
    @{ Slug='resolution'; Year=1965; Era=0; Title='Resolution gives theorem proving a common rule'; Authors='J. A. Robinson'; Paper='A Machine-Oriented Logic Based on the Resolution Principle'; Kind='Journal article'; Venue='Journal of the ACM, 12 (1), 23-41'; Topic='Automated deduction'; Summary='Resolution combined substitution and logical inference in a method designed for computer theorem proving.'; Description='Robinson formulated a resolution rule for first-order logic and proved its completeness. The paper connected this logical result with proof-search procedures and discussed ways to make their search more efficient. It gave automated deduction a precise foundation for deriving contradictions from inconsistent premises.'; Caveat='Completeness does not make every search efficient or guarantee termination on every input. A proof establishes a consequence of its premises, not that the premises describe the real world correctly.'; DateNote='The original article is January 1965, volume 12, issue 1, pages 23-41. SHRDLU reference 47 gives a different issue, month, and page range; the original article controls this entry.'; Url='https://doi.org/10.1145/321250.321253'; LinkLabel='Original journal record'; SecondUrl='https://web.stanford.edu/class/linguist289/robinson65.pdf'; SecondLabel='Original article scan (PDF)'; Tags=@('Reasoning','Logic','Symbolic AI','Search'); CitedBy=@(@{Entry='shrdlu';Note='Reference 47 names this paper, but its issue and page details conflict with the original article.';SourceUrl='https://dspace.mit.edu/server/api/core/bitstreams/bd092d44-1552-4417-a19e-a4704c94d3ff/content'}) }
    @{ Slug='eliza'; Tags=@('Natural language processing','Symbolic AI','Conversational AI'); Year=1966; Era=0; Title='ELIZA and conversational patterns'; Authors='Joseph Weizenbaum'; Paper='ELIZA: A computer program for the study of natural language communication between man and machine'; Kind='Journal article'; Venue='Communications of the ACM, 9 (1), 36–45'; Topic='Language'; Summary='Scripted pattern matching produced a convincing surface of conversation.'; Description='ELIZA analyzed input using rules and transformation patterns to generate replies. The paper showed how a limited conversational program could sustain an interaction without requiring a broad representation of the world.'; Caveat='Fluent-looking replies did not establish that ELIZA understood the conversation. Its behavior depended on scripts and pattern transformations.'; DateNote='The linked article appeared in January 1966.'; Url='https://web.stanford.edu/class/cs124/p36-weizenabaum.pdf'; LinkLabel='Original article scan (PDF)'; ExploreUrl='https://github.com/search?q=eliza&ref=opensearch&type=repositories'; ExploreLabel='Search GitHub for ELIZA repositories' }
    @{ Slug='semantic-memory'; Tags=@('Memory','Recall','Semantic networks','Knowledge representation'); Year=1966; Era=0; Title='Semantic memory as a network of concepts'; Authors='M. Ross Quillian'; Paper='Semantic Memory'; Kind='Research report'; Venue='BBN report 675; AFCRL-66-189'; Topic='Semantic memory'; Summary='Linked concepts let a memory support questions that were not specified when its information was stored.'; Description='Quillian represented knowledge in a connected network and described a program that searched those relations to identify meanings and draw inferences. The model treated recall as an active use of structured knowledge, making stored information useful beyond a fixed list of prewritten questions and answers.'; Caveat='The report proposed and simulated selected semantic abilities. It did not show that a small hand-built network captured all human long-term memory.'; DateNote='1966 dates the original report. SHRDLU uses a 1966 citation label while naming the later chapter in Semantic Information Processing. The report and chapter are distinct publication versions.'; Url='https://books.google.com/books/about/Semantic_Memory.html?id=fYozPQAACAAJ'; LinkLabel='Original report record and author abstract'; CitedBy=@(@{Entry='shrdlu';Note='Reference 44, printed page 461, identifies the chapter version under the 1966 citation label.';SourceUrl='https://dspace.mit.edu/server/api/core/bitstreams/bd092d44-1552-4417-a19e-a4704c94d3ff/content'}) }
    @{ Slug='temporal-recall'; Tags=@('Memory','Recall','Associative memory','Sequence learning'); Year=1968; Era=1; Title='Recall extends through time'; Authors='H. C. Longuet-Higgins'; Paper='Holographic Model of Temporal Recall'; Kind='Journal letter'; Venue='Nature, 217, 104'; Topic='Temporal memory'; Summary='A temporal analogy to holography explored how familiar sequences might be recognized and recalled.'; Description='Longuet-Higgins considered memory for patterns that unfold over time, such as words and behavioral sequences. He proposed a temporal counterpart to holographic storage as a way to think about recognizing and recalling those patterns, extending the question of associative memory from static inputs to sequences.'; Caveat='The letter presents a proposed model and a possible experimental implication. It does not establish that the brain uses a literal optical hologram or that the proposed mechanism is a complete account of recall.'; DateNote='The Nature letter was published on 6 January 1968. The publisher lists H. C. Longuet-Higgins and page 104; these are used instead of the differing initials and page range in the extracted Hopfield reference.'; Url='https://www.nature.com/articles/217104a0'; LinkLabel='Original journal letter'; CitedBy=@(@{Entry='hopfield';Note='Reference 18 identifies the 1968 Nature letter.';SourceUrl='https://authors.library.caltech.edu/records/w41x7-8bn13/files/HOPpnas82.pdf?download=1'}) }
    @{ Slug='theorem-proving-question-answering'; Year=1968; Era=1; Title='QA1 and QA2 derive answers from stored facts'; Authors='C. Cordell Green and Bertram Raphael'; Paper='The Use of Theorem-Proving Techniques in Question-Answering Systems'; Kind='Conference paper'; Venue='ACM National Conference, 169-181'; Topic='Deductive question answering'; Summary='Question answering combined stored facts, relevant retrieval, and deductions that were not explicitly stored.'; Description='QA1 placed facts and logical relationships in list-structured memory and used inference rules to derive answers. QA2 put a formal resolution theorem prover at the center of the question-answering system. The paper separated finding relevant information from deriving new answers, and explored how changing knowledge could avoid rewriting dedicated answering routines.'; Caveat='These were early experimental systems using formal representations and limited examples. Their logical deductions did not establish unrestricted understanding of natural language.'; DateNote='1968 is the conference publication year shown in the original paper. SHRDLU reference 20 uses the label Green 1969b but identifies the 1968 proceedings.'; Url='https://www.kestrel.edu/people/green/publications/green-raphael.pdf'; LinkLabel='Original paper in the author archive (PDF)'; SecondUrl='https://doi.org/10.1145/800186.810578'; SecondLabel='Original proceedings record'; Tags=@('Reasoning','Logic','Memory','Recall','Knowledge representation'); CitedBy=@(@{Entry='shrdlu';Note='Reference 20: the citation label says 1969b, while the proceedings and original paper identify 1968.';SourceUrl='https://dspace.mit.edu/server/api/core/bitstreams/bd092d44-1552-4417-a19e-a4704c94d3ff/content'}) }
    @{ Slug='perceptrons'; Tags=@('Neural networks','Learning theory','Pattern recognition'); Year=1969; Era=1; Title='Mapping the limits of perceptrons'; Authors='Marvin Minsky and Seymour Papert'; Paper='Perceptrons: An Introduction to Computational Geometry'; Kind='Research monograph'; Venue='MIT Press, original edition'; Topic='Theory'; Summary='A mathematical analysis clarified limitations of restricted perceptron architectures.'; Description='Minsky and Papert examined which properties certain perceptron systems could compute. The book is included as a foundational research monograph because its precise questions about representation and computational limits are central to the history of neural networks.'; Caveat='Its results do not disprove the usefulness of all neural networks. Nor does this source establish that one book alone caused an AI funding winter.'; DateNote='1969 is the original edition, not the later expanded edition.'; Url='https://mitpress.mit.edu/9780262130431/perceptrons/'; LinkLabel='Original edition publisher record' }
    @{ Slug='relational-long-term-memory'; Tags=@('Memory','Recall','Knowledge representation','Natural language processing'); Year=1969; Era=1; Title='Remembering a story through relations'; Authors='Alan L. Tharp and Gilbert K. Krulee'; Paper='Using Relational Operators to Structure Long-Term Memory'; Kind='Conference paper'; Venue='IJCAI 1969, 579-586'; Topic='Long-term memory'; Summary='A system stored the relations in an English story so that it could answer questions about the story later.'; Description='Tharp and Krulee converted sentences into predicates and property lists, organized relations across the passage, and used the resulting representation to answer inquiries. Their design explicitly addressed storage, retrieval, temporal organization, and priorities among remembered information. It is an early concrete treatment of memory as part of an interactive reasoning system.'; Caveat='The work illustrates a constrained language and retrieval system, not unrestricted autobiographical memory. Its use of long-term memory describes the model rather than a demonstrated equivalence to human memory.'; DateNote='The original paper appears in the 1969 IJCAI proceedings. SHRDLU lists it as reference 54, with pages 579-586.'; Url='https://www.ijcai.org/Proceedings/69/Papers/051.pdf'; LinkLabel='Original conference paper (PDF)'; CitedBy=@(@{Entry='shrdlu';Note='Reference 54, printed page 462.';SourceUrl='https://dspace.mit.edu/server/api/core/bitstreams/bd092d44-1552-4417-a19e-a4704c94d3ff/content'}) }
    @{ Slug='teachable-language-comprehender'; Tags=@('Memory','Recall','Semantic networks','Natural language processing'); Year=1969; Era=1; Title='New language connects to stored knowledge'; Authors='M. Ross Quillian'; Paper='The teachable language comprehender: a simulation program and theory of language'; Kind='Journal article'; Venue='Communications of the ACM, 12 (8), 459-476'; Topic='Semantic memory'; Summary='The Teachable Language Comprehender related new text to a semantic network and represented what it learned in the same form.'; Description='TLC was designed to connect the assertions in new text with facts already held in a semantic memory. It adapted relevant structures to represent the new material, so that the result could itself become part of memory. Teaching the system facts and interpretation procedures was intended to expand its ability to comprehend later sentences.'; Caveat='The published system contained a limited collection of facts and interpretation capabilities. Its general design should not be mistaken for a demonstrated ability to learn or understand arbitrary English.'; DateNote='The journal article appeared in August 1969. The publisher metadata gives pages 459-476; the SHRDLU bibliography shortens that range to 459-475.'; Url='https://doi.org/10.1145/363196.363214'; LinkLabel='Original journal record'; CitedBy=@(@{Entry='shrdlu';Note='Reference 45, printed page 461.';SourceUrl='https://dspace.mit.edu/server/api/core/bitstreams/bd092d44-1552-4417-a19e-a4704c94d3ff/content'}) }
    @{ Slug='qa3'; Year=1969; Era=1; Title='QA3 constructs solutions through proofs'; Authors='Cordell Green'; Paper='Application of Theorem Proving to Problem Solving'; Kind='Conference paper'; Venue='IJCAI-69'; Topic='Reasoning & planning'; Summary='An extended resolution procedure used proofs to construct solutions to formally described problems.'; Description='Green connected theorem proving with finding an object or action sequence that satisfies a goal. QA3 used explicit descriptions of states and transformations, with demonstrations including small planning problems and simple program construction. This treated a proof as a route to a concrete solution, not just a yes-or-no answer.'; Caveat='The examples required carefully specified axioms and restricted domains. They did not demonstrate reliable planning in an open, changing real-world environment.'; DateNote='1969 dates the IJCAI paper. The linked archive copy identifies itself as a preliminary version; SHRDLU reference 19 cites the conference work.'; Url='https://www.ijcai.org/Proceedings/69/Papers/023.pdf'; LinkLabel='Original IJCAI paper (PDF)'; Tags=@('Reasoning','Planning','Logic','Symbolic AI'); CitedBy=@(@{Entry='shrdlu';Note='Reference 19 cites Application of Theorem Proving to Problem Solving in the 1969 IJCAI proceedings.';SourceUrl='https://dspace.mit.edu/server/api/core/bitstreams/bd092d44-1552-4417-a19e-a4704c94d3ff/content'}) }
    @{ Slug='planner'; Year=1969; Era=1; Title='PLANNER makes reasoning procedures programmable'; Authors='Carl Hewitt'; Paper='PLANNER: A Language for Proving Theorems in Robots'; Kind='Conference paper'; Venue='IJCAI-69, 295-301'; Topic='Procedural reasoning'; Summary='A problem-solving language connected assertions and goals with procedures that controlled inference.'; Description='PLANNER organized reasoning around patterns, goals, and procedures selected when relevant conditions were met. Its language supported adding or withdrawing assertions and breaking goals into subgoals. Hewitt made the control of deduction part of the programming language, linking knowledge representation with the procedures that use that knowledge.'; Caveat='This paper presents a language and problem-solving approach. Its title is not evidence of a general-purpose autonomous robot; successful reasoning still depends on suitable knowledge and procedures.'; DateNote='1969 dates the original IJCAI paper. SHRDLU reference 27 cites it separately from a revised PLANNER memorandum in reference 28.'; Url='https://www.ijcai.org/Proceedings/69/Papers/030.pdf'; LinkLabel='Original IJCAI paper (PDF)'; Tags=@('Reasoning','Planning','Symbolic AI','Tools & frameworks','Knowledge representation'); CitedBy=@(@{Entry='shrdlu';Note='Reference 27 cites the 1969 conference paper; the later memorandum is a separate reference.';SourceUrl='https://dspace.mit.edu/server/api/core/bitstreams/bd092d44-1552-4417-a19e-a4704c94d3ff/content'}) }
    @{ Slug='carps'; Year=1969; Era=1; Title='CARPS reasons over calculus word problems'; Authors='Eugene Charniak'; Paper='Computer Solution of Calculus Word Problems'; Kind='Conference paper'; Venue='IJCAI-69, 303-316'; Topic='Mathematical reasoning'; Summary='Structured descriptions of objects helped a program interpret a limited class of calculus rate problems.'; Description='CARPS gathered information about objects across sentences and connected different expressions referring to the same object. These structures helped transform word problems into a form suitable for mathematical solution. The paper reported fourteen examples, mostly drawn from textbooks, illustrating how domain knowledge could support language interpretation.'; Caveat='The system covered a limited class of rate problems, and some source problems were modified. These examples are not a general calculus benchmark or evidence of unrestricted language understanding.'; DateNote='1969 dates this IJCAI conference paper, rather than the earlier thesis version of CARPS.'; Url='https://www.ijcai.org/Proceedings/69/Papers/031.pdf'; LinkLabel='Original IJCAI paper (PDF)'; Tags=@('Reasoning','Mathematical reasoning','Natural language processing','Knowledge representation'); CitedBy=@(@{Entry='shrdlu';Note='Reference 7 cites the 1969 IJCAI paper, pages 303-316.';SourceUrl='https://dspace.mit.edu/server/api/core/bitstreams/bd092d44-1552-4417-a19e-a4704c94d3ff/content'}) }
    @{ Slug='samenlaq-ii'; Year=1969; Era=1; Title='SAMENLAQ II reasons with a persistent memory network'; Authors='Stuart C. Shapiro and George H. Woodmansee'; Paper='A Net Structure Based Relational Question Answerer: Description and Examples'; Kind='Conference paper'; Venue='IJCAI-69, 325-346'; Topic='Memory & relational reasoning'; Summary='An interactive system stored facts and relation definitions in a network, with memories that could be saved to disk.'; Description='SAMENLAQ II represented facts as binary relations. Relations were also nodes, allowing their definitions to be stored and used while searching for answers. The implementation supported recursive relation definitions, user control over search effort, and disk storage of input files and memories. It joins persistent storage with reasoning over the contents of memory.'; Caveat='Input used formal binary relations, not natural language. The demonstrated inference and persistence do not establish general understanding, unlimited learning, or modern database reliability guarantees.'; DateNote='1969 dates the IJCAI paper. Its implementation section on printed page 326 explicitly describes storing memories in disk files.'; Url='https://www.ijcai.org/Proceedings/69/Papers/034.pdf'; LinkLabel='Original IJCAI paper (PDF)'; Tags=@('Reasoning','Memory','Recall','Semantic networks','Knowledge representation','Persistent memory'); CitedBy=@(@{Entry='shrdlu';Note='Reference 48 cites this paper, pages 325-346. The persistence claim is documented on printed page 326 of the original.';SourceUrl='https://dspace.mit.edu/server/api/core/bitstreams/bd092d44-1552-4417-a19e-a4704c94d3ff/content'}) }
    @{ Slug='shrdlu'; Tags=@('Symbolic AI','Natural language processing','Reasoning','Knowledge representation'); Year=1971; Era=1; Title='SHRDLU grounds language in a small world'; Authors='Terry Winograd'; Paper='Procedures as a Representation for Data in a Computer Program for Understanding Natural Language'; Kind='Thesis / research report'; Venue='MIT Artificial Intelligence Laboratory, AI-TR-235'; Topic='Symbolic AI'; Summary='Language, reasoning, and action were integrated in a constrained blocks world.'; Description='Winograd described a system that interpreted instructions and questions with reference to objects and actions in a small simulated environment. The work demonstrated how syntax, semantic representations, and domain knowledge could cooperate in a conversational system.'; Caveat='The blocks world was deliberately restricted. Success there did not imply general language understanding in open environments.'; DateNote='This timeline uses the 1971 MIT thesis/report, rather than a development date or the 1972 book.'; Url='https://hdl.handle.net/1721.1/7095'; LinkLabel='MIT thesis and report archive' }
    @{ Slug='mycin'; Tags=@('Expert systems','Symbolic AI','Reasoning','Knowledge representation'); Year=1973; Era=1; Title='Expert knowledge becomes explicit rules'; Authors='Edward H. Shortliffe and colleagues'; Paper='An artificial intelligence program to advise physicians regarding antimicrobial therapy'; Kind='Journal article'; Venue='Computers and Biomedical Research, 6 (6), 544–560'; Topic='Expert systems'; Summary='Early MYCIN research explored rule-based advice in a tightly defined specialist domain.'; Description='This paper describes an AI program for advising on antimicrobial therapy. It is a representative publication from expert-system research, where specialized knowledge and inference procedures were encoded explicitly to support decisions within a defined domain.'; Caveat='A historical research system is not evidence of suitability for present-day clinical decisions. The entry makes no claim of routine clinical deployment.'; DateNote='The linked article appeared in December 1973; later MYCIN theses and reports have different dates.'; Url='https://pubmed.ncbi.nlm.nih.gov/4589706/'; LinkLabel='Indexed publication record'; SecondUrl='https://doi.org/10.1016/0010-4809(73)90029-3'; SecondLabel='Original publisher record' }
    @{ Slug='persistent-neural-states'; Tags=@('Memory','Persistent states','Neural networks','Recurrent networks'); Year=1974; Era=1; Title='Persistent activity as a memory mechanism'; Authors='W. A. Little'; Paper='The Existence of Persistent States in the Brain'; Kind='Journal article'; Venue='Mathematical Biosciences, 19, 101-120'; Topic='Persistent neural states'; Summary='A mathematical neural model explored conditions under which patterns of activity could persist.'; Description='Little studied when a neural network could sustain ordered states despite the changing activity of its individual units. He connected this behavior to an analogy with interacting spins and proposed a relationship between persistent states and short-term memory. The work provided a precursor to later treatments of memory through collective network dynamics.'; Caveat='Persistent state here refers to activity in a mathematical neural model. It is not disk storage, an always-running software agent, or a complete biological explanation of memory.'; DateNote='The original article was published in 1974. Hopfield cites its author, year, journal, volume, and page range as reference 8.'; Url='https://doi.org/10.1016/0025-5564(74)90031-5'; LinkLabel='Original journal record'; SecondUrl='https://nessie.ilab.sztaki.hu/~kornai/2023/Hopf/Resources/little_1974.pdf'; SecondLabel='Original article scan (PDF)'; CitedBy=@(@{Entry='hopfield';Note='Reference 8, printed page 2558.';SourceUrl='https://authors.library.caltech.edu/records/w41x7-8bn13/files/HOPpnas82.pdf?download=1'}) }
    @{ Slug='associative-memory'; Tags=@('Memory','Recall','Associative memory','Neural networks'); Year=1977; Era=1; Title='Retrieving a memory from a cue'; Authors='Teuvo Kohonen'; Paper='Associative Memory: A System-Theoretical Approach'; Kind='Research monograph'; Venue='Springer, Communication and Cybernetics, volume 17'; Topic='Associative memory'; Summary='A systematic account connected stored associations, cue-based recall, and adaptive mathematical models.'; Description='Kohonen examined ways to store relationships and retrieve information from a partial cue. The book connected computer-oriented associative search with adaptive mappings and models of biological memory. It gave researchers a common mathematical setting for studying how a stored association can be recovered without supplying its exact address.'; Caveat='The book brings several kinds of associative memory into one framework. They should not be treated as a single mechanism or as proof that every memory system behaves in the same way.'; DateNote='1977 dates the first edition linked here. The publisher also lists a 2012 electronic publication date; that digitization date is not the original publication year.'; Url='https://link.springer.com/book/10.1007/978-3-642-96384-1'; LinkLabel='First-edition publisher record'; CitedBy=@(@{Entry='hopfield';Note='Reference 19 names the 1977 book.';SourceUrl='https://authors.library.caltech.edu/records/w41x7-8bn13/files/HOPpnas82.pdf?download=1'}) }
    @{ Slug='content-addressable-memories'; Tags=@('Memory','Recall','Associative memory','Pattern recognition'); Year=1980; Era=1; Title='Finding information by its content'; Authors='Teuvo Kohonen'; Paper='Content-Addressable Memories'; Kind='Research monograph'; Venue='Springer, Springer Series in Information Sciences, volume 1'; Topic='Associative memory'; Summary='Storage and retrieval were organized around matching content rather than specifying a memory address.'; Description='This book surveyed software methods, circuit principles, and architectures for content-addressable memory. It connected the idea of searching by a cue with practical mechanisms for finding stored information. Alongside Kohonen''s earlier associative-memory monograph, it broadens the history of recall beyond neural models alone.'; Caveat='Content-addressable computer memory and learned neural associative memory overlap conceptually but are not interchangeable implementations. This book covers a range of mechanisms rather than one universal learning algorithm.'; DateNote='The linked first edition is copyrighted 1980. Its electronic publication date of 2012 describes the digital edition, not the original work.'; Url='https://link.springer.com/book/10.1007/978-3-642-96552-4'; LinkLabel='First-edition publisher record'; CitedBy=@(@{Entry='hopfield';Note='Reference 10 cites the 1980 book.';SourceUrl='https://authors.library.caltech.edu/records/w41x7-8bn13/files/HOPpnas82.pdf?download=1'}) }
    @{ Slug='hopfield'; Tags=@('Memory','Recall','Associative memory','Recurrent networks','Neural networks'); Year=1982; Era=1; Title='Memory as a network attractor'; Authors='John J. Hopfield'; Paper='Neural networks and physical systems with emergent collective computational abilities'; Kind='Journal article'; Venue='Proceedings of the National Academy of Sciences, 79 (8), 2554–2558'; Topic='Neural learning'; Summary='Recurrent networks linked associative memory with the dynamics of physical systems.'; Description='Hopfield studied networks whose collective dynamics could recover stored patterns from partial or imperfect input. The relationship between stable states and memory made recurrent neural computation accessible through an energy-based mathematical viewpoint.'; Caveat='Stable states and successful retrieval depend on the model and stored patterns. This is not a model of every form of biological memory.'; DateNote='The journal article appeared in April 1982.'; Url='https://pmc.ncbi.nlm.nih.gov/articles/PMC346238/'; LinkLabel='Full original article in PMC'; SecondUrl='https://pubmed.ncbi.nlm.nih.gov/6953413/'; SecondLabel='Indexed publication record' }
    @{ Slug='backpropagation'; Tags=@('Neural networks','Training methods','Representation learning'); Year=1986; Era=1; Title='Learning internal representations'; Authors='David E. Rumelhart, Geoffrey E. Hinton and Ronald J. Williams'; Paper='Learning representations by back-propagating errors'; Kind='Journal article'; Venue='Nature, 323, 533–536'; Topic='Neural learning'; Summary='Backpropagation demonstrated how hidden units could learn useful internal representations.'; Description='The paper explained how errors at a network output could guide weight changes in earlier layers. Its examples showed that a multilayer network could learn internal features, helping make gradient-based learning a practical research direction.'; Caveat='This influential paper did not invent every form of reverse-mode differentiation or all earlier uses of backpropagation. Credit for the broader history is shared.'; DateNote='The Nature paper was published on 9 October 1986.'; Url='https://www.nature.com/articles/323533a0'; LinkLabel='Original Nature article' }
    @{ Slug='dynamic-error-propagation'; Tags=@('Recurrent networks','Sequence learning','Training methods'); Year=1987; Era=1; Title='Learning while a sequence unfolds'; Authors='A. J. Robinson and F. Fallside'; Paper='The Utility Driven Dynamic Error Propagation Network'; Kind='Technical report'; Venue='Cambridge University Engineering Department, CUED/F-INFENG/TR.1'; Topic='Recurrent learning'; Summary='Dynamic networks extended error-based learning from static patterns to time-varying streams.'; Description='Robinson and Fallside explored architectures for learning finite sequences as well as streams whose length is not known in advance. Their report developed dynamic state representations, examples including speech coding, and a utility signal for training behavior. It belongs to the early work on learning in systems whose current output depends on prior activity.'; Caveat='The report analyzes particular architectures and examples. Its claims do not establish unlimited memory or reliable learning across arbitrarily long sequences.'; DateNote='The report is dated 4 November 1987 and identified as CUED/F-INFENG/TR.1. LSTM cites this technical report, not Robinson''s later doctoral thesis.'; Url='https://gwern.net/doc/ai/nn/rnn/1987-robinson.pdf'; LinkLabel='Original technical report scan (PDF)'; SecondUrl='https://tonyrobinson.com/publications'; SecondLabel='Author bibliography'; CitedBy=@(@{Entry='lstm';Note='The bibliography cites Robinson and Fallside (1987), CUED/F-INFENG/TR.1.';SourceUrl='https://www.bioinf.jku.at/publications/older/2604.pdf'}) }
    @{ Slug='finding-structure-in-time'; Tags=@('Memory','Recurrent networks','Sequence learning','Representation learning'); Year=1988; Era=1; Title='Prior activity becomes context'; Authors='Jeffrey L. Elman'; Paper='Finding Structure in Time'; Kind='Technical report'; Venue='UC San Diego, Center for Research in Language, Technical Report 8801'; Topic='Recurrent memory'; Summary='Feeding earlier hidden activity back into a network created a learned representation of temporal context.'; Description='Elman explored a network whose hidden activity at one time step becomes part of the input for the next. Its internal state therefore reflects both current input and earlier processing. The report studied how such dynamic memory could support sequence prediction and linguistic structure without explicitly storing a fixed window of prior symbols.'; Caveat='A recurrent state is a learned, compressed context, not a lossless transcript. The surviving 1988 newsletter link contains the report abstract; the author archive supplies the later published version.'; DateNote='The April 1988 CRL newsletter identifies Technical Report 8801. LSTM cites this report. The Cognitive Science article appeared in 1990, and that journal version is the one cited by word2vec and LLaMA.'; Url='https://crl.ucsd.edu/newsletter/2-4/2-4.pdf#page=3'; LinkLabel='Dated 1988 report abstract (PDF, page 3)'; SecondUrl='https://jeffelman.ucsd.edu/research/publications/'; SecondLabel='Author archive and 1990 published version'; CitedBy=@(@{Entry='lstm';Note='Cites the 1988 technical report.';SourceUrl='https://www.bioinf.jku.at/publications/older/2604.pdf'},@{Entry='word2vec';Note='Reference 8 cites the later 1990 journal version.';SourceUrl='https://arxiv.org/pdf/1301.3781'},@{Entry='llama';Note='Cites the later 1990 journal version.';SourceUrl='https://arxiv.org/pdf/2302.13971'}) }
    @{ Slug='universal-approximation'; Tags=@('Neural networks','Learning theory','Computation theory'); Year=1989; Era=1; Title='The expressive power of a hidden layer'; Authors='Kurt Hornik, Maxwell Stinchcombe and Halbert White'; Paper='Multilayer feedforward networks are universal approximators'; Kind='Journal article'; Venue='Neural Networks, 2 (5), 359–366'; Topic='Theory'; Summary='Under stated conditions, feedforward networks can approximate broad classes of functions.'; Description='This theoretical work established approximation capabilities of multilayer feedforward networks. It helped explain why even a network with a single hidden layer, when given enough units and suitable assumptions, could represent a rich set of input-output relationships.'; Caveat='Representational capacity does not guarantee that training finds the right weights, that the required network is small, or that predictions generalize.'; DateNote='1989 dates this particular universal-approximation paper; it is not a claim of sole priority for the theorem family.'; Url='https://www.sciencedirect.com/science/article/pii/0893608089900208'; LinkLabel='Original journal article' }
    @{ Slug='finite-state-recurrent-networks'; Tags=@('Recurrent networks','Sequence learning','Computation theory'); Year=1989; Era=1; Title='Recurrent state learns a grammar'; Authors='Axel Cleeremans, David Servan-Schreiber and James L. McClelland'; Paper='Finite State Automata and Simple Recurrent Networks'; Kind='Journal article'; Venue='Neural Computation, 1 (3), 372-381'; Topic='Sequence learning'; Summary='A simple recurrent network learned temporal context sufficient to recognize a studied finite-state grammar.'; Description='The authors trained a network to predict successive elements in sequences generated by a grammar. Feedback from its prior hidden activity let it distinguish contexts that could not be identified from the current symbol alone. The study connected continuous neural representations with the discrete states of an automaton.'; Caveat='Learning the studied grammars does not establish unrestricted natural-language understanding or success on every formal language. The result concerns particular networks, training data, and tasks.'; DateNote='1989 dates the Neural Computation article. LSTM cites the paper as a study of finite-state automata and simple recurrent networks.'; Url='https://doi.org/10.1162/neco.1989.1.3.372'; LinkLabel='Original journal record'; SecondUrl='https://axc.ulb.be/pages/papers'; SecondLabel='Author bibliography and paper links'; CitedBy=@(@{Entry='lstm';Note='Cites Cleeremans, Servan-Schreiber and McClelland (1989).';SourceUrl='https://www.bioinf.jku.at/publications/older/2604.pdf'}) }
    @{ Slug='focused-backpropagation'; Tags=@('Memory','Recurrent networks','Sequence learning','Training methods'); Year=1989; Era=1; Title='Activity traces preserve temporal information'; Authors='Michael C. Mozer'; Paper='A Focused Backpropagation Algorithm for Temporal Pattern Recognition'; Kind='Journal article'; Venue='Complex Systems, 3 (4), 349-381'; Topic='Temporal learning'; Summary='Self-connected hidden units integrated a sequence while local traces supplied information needed for learning.'; Description='Mozer designed a recurrent architecture in which hidden units combine new input with retained activity. The associated learning method focuses error propagation and computes local traces during forward processing. This offered a way to learn temporal patterns without retaining the entire input sequence and every intermediate activation in a separate buffer.'; Caveat='The method is specialized to the proposed architecture. Its compact traces do not imply unlimited recall or remove every difficulty of learning long dependencies.'; DateNote='The original journal paper appeared in 1989. LSTM cites it under the variant title A focused back-propagation algorithm for temporal sequence recognition; this entry uses the title printed by the original journal.'; Url='https://www.complex-systems.com/abstracts/v03_i04_a04/'; LinkLabel='Original journal article and abstract'; SecondUrl='https://home.cs.colorado.edu/~mozer/Research/Selected%20Publications/reprints/Mozer1989.pdf'; SecondLabel='Author-hosted original paper (PDF)'; CitedBy=@(@{Entry='lstm';Note='Cites Mozer (1989), Complex Systems 3, 349-381, with a title variant.';SourceUrl='https://www.bioinf.jku.at/publications/older/2604.pdf'}) }
    @{ Slug='real-time-recurrent-sequences'; Tags=@('Memory','Recurrent networks','Sequence learning','Training methods'); Year=1989; Era=1; Title='Training recurrent memory in real time'; Authors='Anthony W. Smith and David Zipser'; Paper='Learning Sequential Structure with the Real-Time Recurrent Learning Algorithm'; Kind='Journal article'; Venue='International Journal of Neural Systems, 1 (2), 125-131'; Topic='Recurrent learning'; Summary='Real-time recurrent learning was applied to recognizing sequential structure in finite-state grammars.'; Description='Smith and Zipser examined learning in networks with recurrent connections, where retained activity lets earlier events affect current computations. Their study applied the real-time recurrent learning algorithm to sequential structure, contributing to the line of research on how a network can learn to use its own evolving state as memory.'; Caveat='Real-time refers to the way learning updates are computed, not a guarantee of cheap computation or perfect memory. Grammar-learning experiments do not establish general reasoning ability.'; DateNote='1989 dates the journal article. The original title uses the singular Structure; LSTM''s bibliography uses the plural Structures for the same authors, venue, and page range.'; Url='https://doi.org/10.1142/S0129065789000037'; LinkLabel='Original journal record'; CitedBy=@(@{Entry='lstm';Note='Cites Smith and Zipser (1989), International Journal of Neural Systems 1 (2), 125-131.';SourceUrl='https://www.bioinf.jku.at/publications/older/2604.pdf'}) }
    @{ Slug='the-ai-toy'; Tags=@('Neural networks','Machine learning','Education','Pattern recognition'); Year=1990; Era=1; Title='The AI Toy'; Authors='Kevin E. Martin'; Paper='Future Computing: Neural Networks, Parts 1, 2, and 3'; Kind='Magazine series & programs'; Venue='COMPUTE!''s Gazette, January-March 1990'; Topic='AI education & home computing'; Summary='Three commercial magazine articles brought neural-network learning to the Commodore 64, giving readers a practical baseline for what AI could do on a home computer.'; Description='Kevin E. Martin introduced neural-network concepts, backpropagation, and competitive learning through explanations and runnable C64 programs.'; Caveat='These small teaching networks illustrate learning methods under practical constraints.'; DateNote='The three installments appeared in January, February, and March 1990.'; Url='https://archive.org/details/1990-01-computegazette/page/n24/mode/1up'; LinkLabel='Original January article'; SecondUrl='https://github.com/sharpninja/NeuralNetworks'; SecondLabel='Explore the articles and code' }
    @{ Slug='support-vector-networks'; Tags=@('Machine learning','Learning theory','Pattern recognition'); Year=1995; Era=2; Title='Support-vector networks'; Authors='Corinna Cortes and Vladimir Vapnik'; Paper='Support-vector networks'; Kind='Journal article'; Venue='Machine Learning, 20, 273–297'; Topic='Statistical learning'; Summary='Margin-based classification offered a powerful approach to nonlinear learning.'; Description='Cortes and Vapnik developed support-vector networks for classification, combining a margin-based objective with a feature-space view of nonlinear decision boundaries. The paper became a central reference for statistical learning methods.'; Caveat='A large margin is not a universal guarantee of accuracy on new data. Results depend on data, representation, regularization, and evaluation.'; DateNote='The linked journal article was published in September 1995.'; Url='https://link.springer.com/article/10.1007/BF00994018'; LinkLabel='Original journal article' }
    @{ Slug='lstm'; Tags=@('Memory','Recurrent networks','Sequence learning','Training methods'); Year=1997; Era=2; Title='Long Short-Term Memory'; Authors='Sepp Hochreiter and Jürgen Schmidhuber'; Paper='Long Short-Term Memory'; Kind='Journal article'; Venue='Neural Computation, 9 (8), 1735–1780'; Topic='Sequence learning'; Summary='Memory cells and gates addressed difficulties in learning long-range dependencies.'; Description='LSTM introduced a recurrent architecture designed to preserve useful error signals over long intervals. Its memory mechanism and gates provided a way to learn which information to retain and when to use it in sequence tasks.'; Caveat='LSTM mitigates particular learning difficulties; it does not guarantee perfect recall or unlimited reasoning over long sequences.'; DateNote='The original journal paper appeared in November 1997.'; Url='https://direct.mit.edu/neco/article/9/8/1735/6109/Long-Short-Term-Memory'; LinkLabel='Original journal article'; SecondUrl='https://people.idsia.ch/~juergen/lstm1997-2024head.pdf'; SecondLabel='Author-hosted paper (PDF)' }
    @{ Slug='document-recognition'; Tags=@('Neural networks','Computer vision','Pattern recognition','Training methods'); Year=1998; Era=2; Title='Convolutional networks read documents'; Authors='Yann LeCun, Léon Bottou, Yoshua Bengio and Patrick Haffner'; Paper='Gradient-Based Learning Applied to Document Recognition'; Kind='Journal article'; Venue='Proceedings of the IEEE, 86 (11), 2278–2324'; Topic='Computer vision'; Summary='Convolutional networks and gradient-based training connected representation learning with document recognition.'; Description='The paper brought together convolutional architectures, learning methods, and document-recognition systems. It showed how trainable components could be combined into systems for recognizing characters and interpreting documents, including bank-check applications.'; Caveat='The work concerned specific recognition tasks and systems. It did not introduce all convolutional ideas or establish general visual understanding.'; DateNote='The paper appeared in November 1998.'; Url='https://proceedingsoftheieee.ieee.org/gradient-based-learning-applied-to-document-recognition/'; LinkLabel='Original publisher record'; SecondUrl='https://bottou.org/papers/lecun-98h'; SecondLabel='Author publication page' }
    @{ Slug='deep-belief-nets'; Tags=@('Deep learning','Training methods','Representation learning','Generative models'); Year=2006; Era=2; Title='Training deeper networks layer by layer'; Authors='Geoffrey E. Hinton, Simon Osindero and Yee-Whye Teh'; Paper='A Fast Learning Algorithm for Deep Belief Nets'; Kind='Journal article'; Venue='Neural Computation, 18, 1527–1554'; Topic='Deep learning'; Summary='Greedy layerwise learning provided an effective training strategy for deep belief networks.'; Description='The authors introduced a learning algorithm that trained a deep generative model one layer at a time, followed by a fine-tuning procedure. The work helped renew interest in learning useful hierarchies of representations.'; Caveat='Layerwise pretraining is a particular method for particular models. It is not a necessary step in all modern deep learning.'; DateNote='The linked Neural Computation paper was published in 2006.'; Url='https://www.cs.toronto.edu/~hinton/absps/fastnc.pdf'; LinkLabel='Author-hosted original paper (PDF)' }
    @{ Slug='imagenet'; Tags=@('Datasets','Computer vision','Evaluation'); Year=2009; Era=2; Title='ImageNet expands the data frontier'; Authors='Jia Deng and colleagues'; Paper='ImageNet: A Large-Scale Hierarchical Image Database'; Kind='Conference paper'; Venue='IEEE Conference on Computer Vision and Pattern Recognition'; Topic='Datasets'; Summary='A large, organized image database created new opportunities for visual recognition research.'; Description='ImageNet organized images using a semantic hierarchy and supplied labeled examples at a scale intended to support broad object recognition. The paper established the database as research infrastructure, distinct from the later annual challenge.'; Caveat='A dataset is not a model. Benchmark performance measures performance under a particular dataset and evaluation protocol.'; DateNote='The database paper appeared at CVPR 2009. This is distinct from later ImageNet challenge results.'; Url='https://image-net.org/static_files/papers/imagenet_cvpr09.pdf'; LinkLabel='Original project paper (PDF)'; SecondUrl='https://www.image-net.org/about'; SecondLabel='ImageNet project publication information' }
    @{ Slug='scikit-learn'; Tags=@('Machine learning','Tools & frameworks','Evaluation'); Year=2011; Era=2; Title='A shared toolkit for machine learning'; Authors='Fabian Pedregosa and colleagues'; Paper='Scikit-learn: Machine Learning in Python'; Kind='Journal article'; Venue='Journal of Machine Learning Research, 12, 2825–2830'; Topic='Tools & languages'; Summary='A consistent software interface made established learning methods easier to use and compare.'; Description='The scikit-learn paper describes a Python library that brings together supervised and unsupervised learning tools with an emphasis on usability, documentation, and integration with the scientific Python ecosystem.'; Caveat='This milestone concerns research software and access to methods, rather than a new universal learning algorithm.'; DateNote='2011 is the journal paper date. It is not the software project start date.'; Url='https://jmlr.org/papers/v12/pedregosa11a.html'; LinkLabel='Open-access JMLR article' }
    @{ Slug='alexnet'; Tags=@('Deep learning','Computer vision','Pattern recognition','Training methods'); Year=2012; Era=2; Title='Deep convolutional learning at ImageNet scale'; Authors='Alex Krizhevsky, Ilya Sutskever and Geoffrey E. Hinton'; Paper='ImageNet Classification with Deep Convolutional Neural Networks'; Kind='Conference paper'; Venue='Advances in Neural Information Processing Systems'; Topic='Computer vision'; Summary='GPU-trained convolutional networks substantially improved large-scale image classification.'; Description='The system commonly called AlexNet combined a deep convolutional architecture with effective training techniques and GPU computation. Its ImageNet results provided compelling evidence that learned visual representations could improve performance at scale.'; Caveat='The result was a classification benchmark breakthrough, not proof that the system understood images in the full human sense.'; DateNote='The paper appeared at the 2012 neural information processing conference.'; Url='https://papers.nips.cc/paper_files/paper/2012/hash/c399862d3b9d6b76c8436e924a68c45b-Abstract.html'; LinkLabel='Original conference proceedings' }
    @{ Slug='word2vec'; Tags=@('Natural language processing','Representation learning','Neural networks'); Year=2013; Era=3; Title='Efficient word representations'; Authors='Tomas Mikolov and colleagues'; Paper='Efficient Estimation of Word Representations in Vector Space'; Kind='Preprint'; Venue='arXiv:1301.3781'; Topic='Language'; Summary='Efficient training made useful continuous word vectors available at large scale.'; Description='The paper proposed architectures for learning vector representations of words from large text collections. Relationships in the learned space could capture useful syntactic and semantic regularities, supporting downstream language tasks.'; Caveat='Vector relationships are statistical regularities. They do not guarantee factual knowledge or resolve every meaning a word can have in context.'; DateNote='The first arXiv submission was 16 January 2013.'; Url='https://arxiv.org/abs/1301.3781'; LinkLabel='Paper and version history' }
    @{ Slug='gans'; Tags=@('Generative models','Deep learning','Training methods'); Year=2014; Era=3; Title='Generative adversarial learning'; Authors='Ian Goodfellow and colleagues'; Paper='Generative Adversarial Networks'; Kind='Preprint / conference paper'; Venue='arXiv:1406.2661; NIPS 2014'; Topic='Generative models'; Summary='A generator and discriminator learned through an adversarial training objective.'; Description='GANs set two models against one another: a generator produces samples, while a discriminator learns to distinguish generated samples from data. This introduced an influential framework for learning generative models.'; Caveat='The theoretical objective does not make practical training automatically stable. The paper is not the origin of every form of generative modeling.'; DateNote='The preprint was submitted on 10 June 2014. The conference paper uses the title Generative Adversarial Nets.'; Url='https://arxiv.org/abs/1406.2661'; LinkLabel='Paper and version history' }
    @{ Slug='dropout'; Tags=@('Training methods','Neural networks','Deep learning'); Year=2014; Era=3; Title='Dropout regularizes neural networks'; Authors='Nitish Srivastava and colleagues'; Paper='Dropout: A Simple Way to Prevent Neural Networks from Overfitting'; Kind='Journal article'; Venue='Journal of Machine Learning Research, 15, 1929–1958'; Topic='Training methods'; Summary='Randomly omitting units during training helped reduce overfitting.'; Description='Dropout trains with randomly thinned networks so units cannot rely as strongly on specific partners. The paper explains the method and evaluates its ability to improve generalization across several neural-network tasks.'; Caveat='Dropout is a regularization method whose usefulness depends on the architecture and training setup. It is not a guarantee against overfitting.'; DateNote='2014 dates this JMLR article. Earlier dropout work was reported in 2012.'; Url='https://jmlr.org/papers/v15/srivastava14a.html'; LinkLabel='Open-access JMLR article' }
    @{ Slug='deep-q-learning'; Tags=@('Reinforcement learning','Deep learning','Computer vision'); Year=2015; Era=3; Title='Deep reinforcement learning from pixels'; Authors='Volodymyr Mnih and colleagues'; Paper='Human-level control through deep reinforcement learning'; Kind='Journal article'; Venue='Nature, 518, 529–533'; Topic='Reinforcement learning'; Summary='A deep Q-network learned control policies from game images and rewards.'; Description='The work combined reinforcement learning with deep representation learning to tackle Atari games using screen pixels as input. It demonstrated that a shared learning approach could perform strongly across a range of games.'; Caveat='The title does not mean the system exceeded humans at every game. The evaluation concerned the games and protocols described in the paper.'; DateNote='The Nature article appeared on 25 February 2015. Earlier deep Q-learning research was released in 2013.'; Url='https://www.nature.com/articles/nature14236'; LinkLabel='Original Nature article' }
    @{ Slug='resnet'; Tags=@('Deep learning','Computer vision','Training methods'); Year=2015; Era=3; Title='Residual connections make depth easier to train'; Authors='Kaiming He, Xiangyu Zhang, Shaoqing Ren and Jian Sun'; Paper='Deep Residual Learning for Image Recognition'; Kind='Preprint / conference paper'; Venue='arXiv:1512.03385; CVPR 2016'; Topic='Computer vision'; Summary='Residual learning enabled effective optimization of much deeper image-recognition networks.'; Description='ResNet reformulated layers to learn residual functions relative to their inputs, using shortcut connections. The experiments showed how this formulation could ease optimization and improve recognition with substantially deeper networks.'; Caveat='Residual connections address optimization difficulties; attributing the entire result to a single vanishing-gradient explanation oversimplifies the paper.'; DateNote='The preprint was submitted on 10 December 2015; the conference publication followed in 2016.'; Url='https://arxiv.org/abs/1512.03385'; LinkLabel='Paper and version history' }
    @{ Slug='alphago'; Tags=@('Reinforcement learning','Search','Deep learning'); Year=2016; Era=3; Title='Neural networks meet tree search in Go'; Authors='David Silver and colleagues'; Paper='Mastering the game of Go with deep neural networks and tree search'; Kind='Journal article'; Venue='Nature, 529, 484–489'; Topic='Reinforcement learning'; Summary='Policy and value networks strengthened search in a difficult board game.'; Description='AlphaGo combined neural networks for selecting moves and evaluating positions with a tree-search procedure. The system integrated supervised learning from expert play and reinforcement learning to reach a major milestone in computer Go.'; Caveat='This paper reports the match against Fan Hui. It does not report the later March 2016 Lee Sedol match, and it concerns a specific game.'; DateNote='The paper appeared on 27 January 2016 and reports the October 2015 Fan Hui match.'; Url='https://www.nature.com/articles/nature16961'; LinkLabel='Original Nature article' }
    @{ Slug='tensorflow'; Tags=@('Tools & frameworks','Machine learning','Deep learning'); Year=2016; Era=3; Title='TensorFlow scales the learning system'; Authors='Martín Abadi and colleagues'; Paper='TensorFlow: A system for large-scale machine learning'; Kind='Preprint / conference paper'; Venue='arXiv:1605.08695; OSDI 2016'; Topic='Tools & languages'; Summary='A dataflow system supported machine-learning workloads across different computing devices.'; Description='The TensorFlow systems paper describes a framework for expressing and executing machine-learning computations across heterogeneous hardware. It addresses the engineering needed to connect experimentation with larger-scale training and deployment.'; Caveat='A software framework enables many models; it is not itself an intelligence algorithm or evidence that any application built with it is reliable.'; DateNote='The paper was first submitted on 27 May 2016. The software was released earlier, in 2015.'; Url='https://arxiv.org/abs/1605.08695'; LinkLabel='Paper and version history' }
    @{ Slug='transformer'; Tags=@('Transformers','Attention','Sequence learning','Natural language processing'); Year=2017; Era=4; Title='Attention Is All You Need'; Authors='Ashish Vaswani and colleagues'; Paper='Attention Is All You Need'; Kind='Preprint / conference paper'; Venue='arXiv:1706.03762; NIPS 2017'; Topic='Architecture'; Summary='The Transformer replaced recurrence with attention in a sequence-to-sequence architecture.'; Description='The paper introduced an encoder-decoder architecture built around attention mechanisms, with positional information to represent sequence order. Translation experiments demonstrated strong results while allowing greater parallelization during training than recurrent approaches.'; Caveat='The original study focused on sequence transduction. The title does not establish that attention alone is sufficient for every kind of intelligence.'; DateNote='The first arXiv submission was 12 June 2017, not 2022.'; Url='https://arxiv.org/abs/1706.03762'; LinkLabel='Paper and version history' }
    @{ Slug='bert'; Tags=@('Transformers','Natural language processing','Representation learning','Transfer learning'); Year=2018; Era=4; Title='BERT learns bidirectional language representations'; Authors='Jacob Devlin, Ming-Wei Chang, Kenton Lee and Kristina Toutanova'; Paper='BERT: Pre-training of Deep Bidirectional Transformers for Language Understanding'; Kind='Preprint / conference paper'; Venue='arXiv:1810.04805; NAACL 2019'; Topic='Language'; Summary='Masked pretraining helped a bidirectional Transformer transfer to many language tasks.'; Description='BERT learned representations using context on both sides of masked tokens, then adapted those representations to downstream tasks through fine-tuning. The approach reduced the need for elaborate task-specific architectures in the evaluated settings.'; Caveat='BERT is an encoder model with a different training setup from an autoregressive text generator. Benchmark gains do not establish unrestricted understanding.'; DateNote='The preprint appeared on 11 October 2018; the conference paper followed in 2019.'; Url='https://arxiv.org/abs/1810.04805'; LinkLabel='Paper and version history' }
    @{ Slug='gpt-2'; Tags=@('Language models','Transformers','Generative models','Transfer learning'); Year=2019; Era=4; Title='GPT-2 explores zero-shot task transfer'; Authors='Alec Radford and colleagues'; Paper='Language Models are Unsupervised Multitask Learners'; Kind='Technical report'; Venue='OpenAI'; Topic='Language'; Summary='A language model performed several tasks without task-specific parameter updates.'; Description='The GPT-2 report evaluated whether next-token prediction over a large web-text dataset could support a variety of language tasks. Task performance emerged from conditioning the model on text, without retraining it separately for each evaluated task.'; Caveat='Performance varied substantially by task. The report did not demonstrate a generally reliable problem solver, and model weights were released in stages.'; DateNote='The report accompanied the 14 February 2019 announcement. The largest model was released later that year.'; Url='https://cdn.openai.com/better-language-models/language_models_are_unsupervised_multitask_learners.pdf'; LinkLabel='Original technical report (PDF)'; SecondUrl='https://openai.com/index/better-language-models/'; SecondLabel='Dated author announcement' }
    @{ Slug='pytorch'; Tags=@('Tools & frameworks','Machine learning','Deep learning'); Year=2019; Era=4; Title='PyTorch bridges flexibility and performance'; Authors='Adam Paszke and colleagues'; Paper='PyTorch: An Imperative Style, High-Performance Deep Learning Library'; Kind='Preprint / conference paper'; Venue='arXiv:1912.01703; NeurIPS 2019'; Topic='Tools & languages'; Summary='An imperative programming style supported flexible research with efficient tensor computation.'; Description='The paper describes PyTorch as a deep-learning library combining a familiar imperative programming model with automatic differentiation and accelerated computation. It explains system choices intended to support both experimentation and performance.'; Caveat='This is a systems contribution. The publication year does not mark the first public availability of the library.'; DateNote='The paper appeared at NeurIPS 2019; its arXiv submission is dated 3 December 2019.'; Url='https://arxiv.org/abs/1912.01703'; LinkLabel='Paper and version history' }
    @{ Slug='scaling-laws'; Tags=@('Scaling','Language models','Learning theory'); Year=2020; Era=5; Title='Language-model scaling becomes measurable'; Authors='Jared Kaplan and colleagues'; Paper='Scaling Laws for Neural Language Models'; Kind='Preprint'; Venue='arXiv:2001.08361'; Topic='Scaling'; Summary='Empirical relationships connected language-model loss with parameters, data, and compute.'; Description='The authors measured how language-model performance varied with model size, dataset size, and training compute. Approximate scaling relationships offered a way to reason about resource allocation within the studied training regimes.'; Caveat='These are empirical relationships over investigated ranges. They do not prove indefinite improvement, factual reliability, or inevitable general intelligence.'; DateNote='The first arXiv submission was 23 January 2020.'; Url='https://arxiv.org/abs/2001.08361'; LinkLabel='Paper and version history' }
    @{ Slug='gpt-3'; Tags=@('Language models','Transformers','Prompting','Transfer learning','Scaling'); Year=2020; Era=5; Title='GPT-3 learns tasks from examples in context'; Authors='Tom B. Brown and colleagues'; Paper='Language Models are Few-Shot Learners'; Kind='Preprint / conference paper'; Venue='arXiv:2005.14165; NeurIPS 2020'; Topic='Language'; Summary='A large language model performed many tasks using demonstrations supplied in its prompt.'; Description='The paper evaluated GPT-3 in zero-shot, one-shot, and few-shot settings. In the few-shot setup, task examples were placed in the input context, and the model generated answers without task-specific gradient updates.'; Caveat='Learning in context is distinct from updating model weights. The paper also documents weaknesses, and its results do not guarantee truthfulness.'; DateNote='The preprint was submitted on 28 May 2020, not 2022.'; Url='https://arxiv.org/abs/2005.14165'; LinkLabel='Paper and version history' }
    @{ Slug='ddpm'; Tags=@('Diffusion','Generative models','Computer vision'); Year=2020; Era=5; Title='Denoising diffusion produces high-quality images'; Authors='Jonathan Ho, Ajay Jain and Pieter Abbeel'; Paper='Denoising Diffusion Probabilistic Models'; Kind='Preprint / conference paper'; Venue='arXiv:2006.11239; NeurIPS 2020'; Topic='Generative models'; Summary='Learning to reverse gradual noising became an effective image-generation method.'; Description='The paper developed a training formulation for diffusion probabilistic models and demonstrated strong image-generation results. Generation follows a learned denoising process that transforms noise into samples.'; Caveat='Diffusion modeling has earlier research predecessors. This paper is a major formulation and demonstration, not the invention of all diffusion-based generative models.'; DateNote='The preprint was submitted on 19 June 2020. Both the preprint and conference paper are from 2020, not 2021.'; Url='https://arxiv.org/abs/2006.11239'; LinkLabel='Paper and version history' }
    @{ Slug='clip'; Tags=@('Multimodal AI','Computer vision','Natural language processing','Representation learning','Transfer learning'); Year=2021; Era=5; Title='CLIP connects images with natural language'; Authors='Alec Radford and colleagues'; Paper='Learning Transferable Visual Models From Natural Language Supervision'; Kind='Preprint / conference paper'; Venue='arXiv:2103.00020; ICML 2021'; Topic='Multimodal models'; Summary='Contrastive learning from image-text pairs enabled transfer through natural-language descriptions.'; Description='CLIP learned to associate images with their accompanying text. By comparing an image with text descriptions of candidate classes, the model could perform zero-shot classification without fitting a separate classifier to each evaluated dataset.'; Caveat='Transfer performance depends on the task and prompts. Associations learned from web data are not equivalent to grounded or unbiased understanding.'; DateNote='The arXiv record lists a first submission of 26 February 2021, despite its 2103 identifier.'; Url='https://arxiv.org/abs/2103.00020'; LinkLabel='Paper and version history' }
    @{ Slug='latent-diffusion'; Tags=@('Diffusion','Generative models','Computer vision','Efficient models'); Year=2021; Era=5; Title='Diffusion moves into a compressed latent space'; Authors='Robin Rombach and colleagues'; Paper='High-Resolution Image Synthesis with Latent Diffusion Models'; Kind='Preprint / conference paper'; Venue='arXiv:2112.10752; CVPR 2022'; Topic='Generative models'; Summary='Performing denoising in a learned latent space reduced the computational burden of image synthesis.'; Description='Latent diffusion models combine an image compression model with a diffusion process operating on its latent representation. The work also introduces flexible conditioning, enabling tasks such as text-guided image generation.'; Caveat='This publication is distinct from the subsequent release of Stable Diffusion. A paper date and a product or model-release date need not match.'; DateNote='The first preprint appeared on 20 December 2021; the conference paper was published in 2022.'; Url='https://arxiv.org/abs/2112.10752'; LinkLabel='Paper and version history' }
    @{ Slug='chain-of-thought'; Tags=@('Reasoning','Prompting','Language models'); Year=2022; Era=6; Title='Worked reasoning examples guide prompting'; Authors='Jason Wei and colleagues'; Paper='Chain-of-Thought Prompting Elicits Reasoning in Large Language Models'; Kind='Preprint / conference paper'; Venue='arXiv:2201.11903; NeurIPS 2022'; Topic='Reasoning methods'; Summary='Prompts containing intermediate reasoning examples improved performance on several reasoning benchmarks.'; Description='The paper studied demonstrations that include a sequence of intermediate steps before an answer. With sufficiently large language models, these worked examples improved results on tasks such as arithmetic and symbolic reasoning.'; Caveat='A generated chain of thought is not guaranteed to be correct or a faithful account of the model computation. This paper is distinct from zero-shot step-by-step prompting.'; DateNote='The preprint was first submitted in January 2022.'; Url='https://arxiv.org/abs/2201.11903'; LinkLabel='Paper and version history' }
    @{ Slug='instructgpt'; Tags=@('Alignment','Human feedback','Language models','Reinforcement learning'); Year=2022; Era=6; Title='Human feedback shapes instruction following'; Authors='Long Ouyang and colleagues'; Paper='Training language models to follow instructions with human feedback'; Kind='Preprint / conference paper'; Venue='arXiv:2203.02155; NeurIPS 2022'; Topic='Alignment'; Summary='Supervised examples and human preference feedback improved how language models followed instructions.'; Description='InstructGPT combined supervised fine-tuning with a reward model trained from human rankings and reinforcement learning. Evaluators preferred outputs from the resulting models over those from the larger baseline in the studied comparisons.'; Caveat='Preference improvements do not eliminate hallucinations, bias, or unsafe behavior. Results depend in part on the instructions and people providing feedback.'; DateNote='The first arXiv submission was 4 March 2022.'; Url='https://arxiv.org/abs/2203.02155'; LinkLabel='Paper and version history' }
    @{ Slug='zero-shot-reasoning'; Tags=@('Reasoning','Prompting','Language models'); Year=2022; Era=6; Title='Zero-shot step-by-step prompting'; Authors='Takeshi Kojima and colleagues'; Paper='Large Language Models are Zero-Shot Reasoners'; Kind='Preprint / conference paper'; Venue='arXiv:2205.11916; NeurIPS 2022'; Topic='Reasoning methods'; Summary='A simple step-by-step instruction improved reasoning results without worked examples in the prompt.'; Description='The paper investigated prompting language models to reason through a problem before extracting an answer. The phrase “Let''s think step by step” improved performance on several benchmark tasks without supplying task-specific reasoning demonstrations.'; Caveat='The effect is empirical and task-dependent. It neither guarantees valid reasoning nor makes every model a reliable zero-shot reasoner.'; DateNote='The preprint was submitted on 24 May 2022. This is the source for the familiar zero-shot phrase, distinct from Wei and colleagues'' worked-example method.'; Url='https://arxiv.org/abs/2205.11916'; LinkLabel='Paper and version history' }
    @{ Slug='constitutional-ai'; Tags=@('Alignment','Language models','Reinforcement learning'); Year=2022; Era=6; Title='Principles guide AI feedback'; Authors='Yuntao Bai and colleagues'; Paper='Constitutional AI: Harmlessness from AI Feedback'; Kind='Preprint'; Venue='arXiv:2212.08073'; Topic='Alignment'; Summary='Written principles guided self-critique and AI-generated feedback during training.'; Description='Constitutional AI used a set of principles to guide revisions of model responses and to help generate preference feedback. The paper explored reducing dependence on human labels for judgments of harmfulness while improving the behavior of an assistant.'; Caveat='Human choices remain in the principles and other parts of the training process. The method does not establish that the model is harmless in every situation.'; DateNote='The first arXiv submission was 15 December 2022.'; Url='https://arxiv.org/abs/2212.08073'; LinkLabel='Paper and version history' }
    @{ Slug='llama'; Tags=@('Language models','Transformers','Efficient models','Scaling'); Year=2023; Era=7; Title='LLaMA examines efficient foundation models'; Authors='Hugo Touvron and colleagues'; Paper='LLaMA: Open and Efficient Foundation Language Models'; Kind='Preprint'; Venue='arXiv:2302.13971'; Topic='Language'; Summary='A family of language models emphasized training efficiency and publicly available training data.'; Description='The original LLaMA paper introduced models spanning 7 to 65 billion parameters and examined how training choices affected performance. It showed that smaller models trained extensively could be competitive on the reported benchmarks.'; Caveat='The original release had restricted research access. The word “open” in the title does not establish an unrestricted open-source license or full reproducibility.'; DateNote='The first arXiv submission was 27 February 2023.'; Url='https://arxiv.org/abs/2302.13971'; LinkLabel='Paper and version history' }
    @{ Slug='gpt-4'; Tags=@('Language models','Multimodal AI','Evaluation','Alignment'); Year=2023; Era=7; Title='GPT-4 reports broader multimodal capability'; Authors='OpenAI'; Paper='GPT-4 Technical Report'; Kind='Technical report'; Venue='arXiv:2303.08774'; Topic='Multimodal models'; Summary='A large model accepted image and text inputs and generated text outputs.'; Description='The report describes GPT-4 evaluation across a range of professional, academic, and language benchmarks, alongside limitations and safety work. It documents a multimodal model while withholding many details of its architecture and training.'; Caveat='Limited technical disclosure constrains independent reproduction. Strong benchmark results do not establish general intelligence or consistent factual accuracy.'; DateNote='The technical report was first submitted on 15 March 2023. GPT-4o is a separate, later model.'; Url='https://arxiv.org/abs/2303.08774'; LinkLabel='Report and version history' }
    @{ Slug='mistral-7b'; Tags=@('Language models','Attention','Transformers','Efficient models'); Year=2023; Era=7; Title='Mistral 7B focuses on efficient attention'; Authors='Albert Q. Jiang and colleagues'; Paper='Mistral 7B'; Kind='Technical report'; Venue='arXiv:2310.06825'; Topic='Efficient models'; Summary='Grouped-query and sliding-window attention supported an efficient language-model architecture.'; Description='The report presents Mistral 7B and evaluates it against other models on a range of tasks. Its architecture uses grouped-query attention and sliding-window attention to improve inference efficiency and manage attention computation.'; Caveat='Benchmark comparisons describe the models and evaluation setups in the report. They should not be read as a permanent ranking of available systems.'; DateNote='The paper was submitted on 10 October 2023; the model announcement was on 27 September 2023.'; Url='https://arxiv.org/abs/2310.06825'; LinkLabel='Report and version history'; SecondUrl='https://mistral.ai/news/announcing-mistral-7b/'; SecondLabel='Dated model announcement' }
    @{ Slug='mixtral'; Tags=@('Language models','Mixture of experts','Efficient models','Transformers'); Year=2024; Era=7; Title='Mixtral activates a sparse set of experts'; Authors='Albert Q. Jiang and colleagues'; Paper='Mixtral of Experts'; Kind='Technical report'; Venue='arXiv:2401.04088'; Topic='Efficient models'; Summary='Sparse routing selected two of eight feedforward experts per token at each layer.'; Description='Mixtral uses a sparse mixture-of-experts architecture: a routing mechanism chooses which expert networks process each token. This separates total model capacity from the amount of expert computation used for an individual token.'; Caveat='Only part of the model is active per token, but storing the model still requires its full weights. Sparse activation is not the same as a small total model.'; DateNote='The paper was submitted on 8 January 2024. The model was released in December 2023, so both years can be correct when clearly labeled.'; Url='https://arxiv.org/abs/2401.04088'; LinkLabel='Report and version history'; SecondUrl='https://mistral.ai/news/mixtral-of-experts/'; SecondLabel='December 2023 model announcement' }
    @{ Slug='gemini-1-5'; Tags=@('Multimodal AI','Long context','Language models','Mixture of experts'); Year=2024; Era=7; Title='Gemini 1.5 studies long multimodal context'; Authors='Gemini Team'; Paper='Gemini 1.5: Unlocking multimodal understanding across millions of tokens of context'; Kind='Technical report'; Venue='arXiv:2403.05530'; Topic='Multimodal models'; Summary='Long-context experiments included text, video, and audio within a multimodal model family.'; Description='The report evaluates models designed to process very long inputs and retrieve or reason over information within them. Its experiments explore how extended context can support work with long documents and other media.'; Caveat='Context capacity and retrieval results do not guarantee perfect comprehension of every long input. Claims remain tied to the report and its evaluation conditions.'; DateNote='The first arXiv submission was 8 March 2024. The record also contains later revisions.'; Url='https://arxiv.org/abs/2403.05530'; LinkLabel='Report and version history' }
    @{ Slug='deepseek-r1'; Tags=@('Reasoning','Reinforcement learning','Language models','Training methods'); Year=2025; Era=7; Title='DeepSeek-R1 explores reinforcement learning for reasoning'; Authors='DeepSeek-AI'; Paper='DeepSeek-R1: Incentivizing Reasoning Capability in LLMs via Reinforcement Learning'; Kind='Technical report / preprint'; Venue='arXiv:2501.12948, version 1'; Topic='Reasoning methods'; Summary='Reinforcement learning improved reasoning benchmarks, with distinct training paths for R1-Zero and R1.'; Description='The report studies reasoning behavior developed through reinforcement learning. R1-Zero applies reinforcement learning to a pretrained base model without preliminary supervised fine-tuning. R1 adds cold-start data and multiple training stages to improve the resulting system.'; Caveat='R1-Zero and R1 must not be conflated. “No preliminary supervised fine-tuning” does not mean the base model was untrained, and benchmark success does not guarantee correct reasoning.'; DateNote='The original report was submitted on 22 January 2025, not 2024. This entry links version 1 to anchor the original report.'; Url='https://arxiv.org/abs/2501.12948v1'; LinkLabel='Original report and submission history' }
